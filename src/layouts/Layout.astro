---
import '@fontsource/noto-sans-jp/500.css';
import '@fontsource/noto-sans-jp/700.css';

import {
  X_ID,
  COLOR,
  OGP_IMAGE
} from '@/constants';
import { siteUrl, resolveAbsoluteUrl } from '@/utils/url';
import {
  DEFAULT_LOCALE,
  LOCALES,
  OG_LOCALES,
  getLangFromUrl,
  localizePath,
  otherLocale,
  stripLocale,
  useTranslations,
} from '@/i18n';

import SplashScreen from '@/components/SplashScreen.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BottomNavigation from '@/components/BottomNavigation.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, any>;
  showSplash?: boolean;
  // 404 など言語別 URL が存在しないページでは hreflang を出力しない
  noAlternate?: boolean;
}

const { title, description, ogImage, ogType, jsonLd, showSplash = false, noAlternate = false } = Astro.props;

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = title ? `${title} | ${t.site.title}` : t.site.title;
const pageDescription = description || t.site.description;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const basePath = stripLocale(Astro.url.pathname);
const alternateUrls = LOCALES.map(l => ({
  locale: l,
  href: new URL(localizePath(basePath, l), siteUrl).href,
}));
const xDefaultUrl = alternateUrls.find(alt => alt.locale === DEFAULT_LOCALE)?.href;

// OGP画像を絶対URLに解決
const ogImageUrl = resolveAbsoluteUrl(ogImage || OGP_IMAGE);
---

<!DOCTYPE html>
<!--

============================================================
  #   #   ###   ####   ####   ###  #   #  ####   ###   ###
  #   #  #   #  #   #  #   #   #   ##  #  #     #     #
  #####  #####  ####   ####    #   # # #  ###    ##    ##
  #   #  #   #  #      #       #   #  ##  #        #     #
  #   #  #   #  #      #      ###  #   #  ####  ###   ###
============================================================

-->
<html lang={locale} class="overflow-x-hidden min-h-screen">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="max-image-preview:large">

    <!-- Preconnect / DNS Prefetch -->
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com">
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin>
    <link rel="dns-prefetch" href="https://assets.akkunlab.dev">
    <link rel="preconnect" href="https://assets.akkunlab.dev" crossorigin>

    <title>{pageTitle}</title>

    <meta name="description" content={pageDescription}>
    <meta name="author" content={t.author}>
    <meta name="theme-color" content={COLOR}>

    <meta property="og:locale" content={OG_LOCALES[locale]}>
    <meta property="og:locale:alternate" content={OG_LOCALES[otherLocale(locale)]}>
    <meta property="og:type" content={ogType || 'website'}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={pageDescription}>
    <meta property="og:site_name" content={t.site.title}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={ogImageUrl}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content={ogImageUrl}>
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:site" content={X_ID}>

    <link rel="canonical" href={canonicalUrl}>
    {!noAlternate && alternateUrls.map(alt => (
      <link rel="alternate" hreflang={alt.locale} href={alt.href}>
    ))}
    {!noAlternate && xDefaultUrl && (
      <link rel="alternate" hreflang="x-default" href={xDefaultUrl}>
    )}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="icon" type="image/png" href="/android-touch-icon.png" sizes="192x192">

    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="font-body text-light-text overflow-x-hidden min-w-[360px] min-h-screen">
    {showSplash && <SplashScreen />}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BottomNavigation />

    <script>
      import { setupScrollAnimations } from '../utils/scrollAnimation';

      window.addEventListener('load', setupScrollAnimations);
    </script>
  </body>

</html>
