---
interface Props {
  items: Array<{
    date: string;
    title: string;
    description: string;
  }>;
}

const { items } = Astro.props;
---

<div class="cyber-timeline relative py-6 pl-0">

  <!-- メインの縦線 -->
  <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-400 via-cyan-400 to-blue-600 shadow-[0_0_10px_rgba(59,130,246,0.5)]"></div>

  <!-- タイムラインアイテム -->
  {items.map((item) => (
    <div class="cyber-timeline-item relative flex items-start mb-8 md:mb-12 fade-in-text opacity-0 translate-y-8 transition-all duration-300 ease-out flex-row">

      {/* ノード */}
      <div class="cyber-node absolute left-0 z-10 w-12 h-12 md:w-12 md:h-12 sm:w-10 sm:h-10 flex items-center justify-center transition-transform duration-300 ease-out hover:scale-110">
        
        {/* 外側のリング */}
        <div class="absolute inset-0 rounded-full border-2 border-blue-400 shadow-[0_0_15px_rgba(59,130,246,0.6)] animate-pulse"></div>
        
        {/* 中間リング */}
        <div class="absolute inset-2 rounded-full border border-cyan-300/50"></div>

        {/* 内側のコア */}
        <div class="w-6 h-6 md:w-6 md:h-6 sm:w-5 sm:h-5 rounded-full bg-gradient-to-r from-blue-400 to-cyan-400 shadow-[0_0_10px_rgba(59,130,246,0.8)] relative">
          <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-1.5 h-1.5 sm:w-1 sm:h-1 bg-white rounded-full animate-pulse"></div>
        </div>
        
        {/* グロー効果 */}
        <div class="absolute inset-0 rounded-full bg-blue-400/20 animate-ping"></div>
      </div>
      
      {/* コンテンツボックス */}
      <div class="cyber-content flex-1 max-w-lg md:max-w-lg sm:max-w-[calc(100vw-6rem)] ml-16">
        <div class="cyber-card relative p-5 sm:p-4 bg-gradient-to-br from-slate-800/95 to-slate-900/95 backdrop-blur-sm border border-slate-600/50 rounded-lg overflow-hidden transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-[1.02] hover:shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_10px_10px_-5px_rgba(0,0,0,0.04),0_0_0_1px_rgba(59,130,246,0.3),0_0_30px_rgba(59,130,246,0.4)] hover:border-blue-400/60 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-1px_rgba(0,0,0,0.06),0_0_0_1px_rgba(59,130,246,0.1)]">
          
          {/* ホログラフィック効果 */}
          <div class="absolute inset-0 bg-gradient-to-r from-blue-500/15 via-transparent to-cyan-500/15 pointer-events-none"></div>
          
          {/* アニメーション付きスキャンライン */}
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-cyan-400/20 to-transparent h-1 animate-[scanLine_3s_ease-in-out_infinite]"></div>
          
          {/* グロー境界線 */}
          <div class="absolute inset-0 rounded-lg border border-blue-400/40 shadow-[0_0_15px_rgba(59,130,246,0.4)]"></div>
          
          {/* 角のアクセント */}
          <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-cyan-400 opacity-80"></div>
          <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-cyan-400 opacity-80"></div>
          <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-cyan-400 opacity-80"></div>
          <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-cyan-400 opacity-80"></div>
          
          {/* データフロー効果 */}
          <div class="absolute top-2 right-2 w-2 h-2 bg-green-400 rounded-full animate-[dataFlow_2s_ease-in-out_infinite]"></div>
          <div class="absolute bottom-2 left-2 w-1.5 h-1.5 bg-blue-400 rounded-full animate-[dataFlow_2s_ease-in-out_infinite] [animation-delay:0.5s]"></div>
          
          {/* コンテンツ */}
          <div class="relative z-10">
            <time class="inline-block text-sm text-cyan-300 font-mono bg-cyan-400/15 px-3 py-1.5 rounded-full border border-cyan-400/30 shadow-[0_0_5px_rgba(34,211,238,0.3)]">
              {item.date}
            </time>
            <h3 class="text-lg sm:text-base font-bold text-primary-content mt-3 mb-2 flex items-center">
              {item.title}
            </h3>
            <p class="text-slate-300 leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      </div>
    </div>
  ))}
</div>
