---
import { Image } from 'astro:assets';

import heroImage from '@/assets/images/hero-image.jpg';
import akkunlab from '@/assets/images/akkunlab.png';

const heroImages = [
  {
    src: heroImage,
    alt: 'メインビジュアル 1',
  }, {
    src: akkunlab,
    alt: 'メインビジュアル 2',
  }
];
const carouselDuration = 14; // seconds
---

<div class="relative inset-0">
  {[0, 1, 0].map((imageIndex, sequenceIndex) => (
    <Image 
      src={heroImages[imageIndex].src}
      alt={heroImages[imageIndex].alt}
      class="absolute animate-carousel h-screen w-full object-cover"
      style={{ animationDelay: `${carouselDuration * (0.9 - 0.45 * sequenceIndex)}s` }}
      loading={sequenceIndex === 1 ? "eager" : "lazy"}
    />
  ))}
</div>
