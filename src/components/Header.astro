---
import { AUTHOR_ENGLISH } from '@/constants/siteData';

const navItems = [
  { label: '作品', href: '/#works' },
  { label: '活動', href: '/#activities' },
  { label: 'プロフィール', href: '/#profile' },
  { label: 'リンク', href: '/#links' }
];
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/' || currentPath === '';
---

<header id="header" class="fixed top-0 w-full h-16 flex justify-center md:justify-between items-center px-6 z-50 backdrop-blur-lg bg-header-bg border-b border-header-border shadow-xl transition-transform duration-300">
  <a class="btn btn-ghost text-xl text-primary-content" href="/">{AUTHOR_ENGLISH.toUpperCase()}</a>
  <nav class="hidden md:flex gap-4">
    {navItems.map(item => (
      <a 
        class="btn btn-ghost text-xl hover:bg-header-hover text-primary-content" 
        href={item.href}
        data-scroll={isHomePage && item.href.startsWith('/#') ? 'true' : 'false'}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>
