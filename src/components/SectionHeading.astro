---
interface Props {
  title: string;
}

const { title } = Astro.props as Props;
---

<div class="relative overflow-hidden py-4 px-4 max-w-[500px] w-full mx-auto rounded-full">
  
  <!-- グラデーション背景 -->
  <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-gray-900 to-black opacity-95 rounded-full">
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/30 rounded-2xl"></div>
  </div>

  <!-- ホログラフィックデータストリーム -->
  <div class="absolute inset-0 opacity-30">
    <div class="absolute top-5 left-9 w-2 h-2 bg-cyan-400 rounded-full animate-ping shadow-lg shadow-cyan-400/50"></div>
    <div class="absolute top-5 right-14 w-2 h-2 bg-purple-400 rounded-full animate-pulse delay-100 shadow-lg shadow-purple-400/50"></div>
    <div class="absolute bottom-5 left-14 w-2 h-2 bg-blue-400 rounded-full animate-bounce delay-200 shadow-lg shadow-blue-400/50"></div>
    <div class="absolute bottom-5 right-9 w-2 h-2 bg-pink-400 rounded-full animate-ping delay-300 shadow-lg shadow-pink-400/50"></div>
  </div>

  <!-- ライン -->
  <div class="absolute inset-0 opacity-40">
    <div class="absolute top-1/2 left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-500 to-transparent animate-pulse shadow-sm shadow-cyan-500/30"></div>
    <div class="absolute top-0 bottom-0 left-1/2 w-px bg-gradient-to-b from-transparent via-purple-500 to-transparent animate-pulse delay-500 shadow-sm shadow-purple-500/30"></div>
  </div>

  <!-- ホログラフィックフレーム -->
  <div class="absolute inset-2 border border-cyan-400/20 opacity-0 animate-fadeIn delay-500 rounded-full"></div>

  <!-- メイン -->
  <div class="relative z-10 text-center flex flex-col justify-center">

    <!-- タイトル -->
    <h2 class="text-3xl sm:text-5xl font-black text-white opacity-0 animate-fadeInUpGlow">
      {title}
    </h2>

    <!-- プログレスバー -->
    <div class="mt-3 flex justify-center">
      <div class="w-[60%] h-0.5 bg-gray-800 rounded-full overflow-hidden">
        <div class="h-full bg-gradient-to-r from-cyan-400 via-purple-500 to-pink-500 rounded-full w-0 animate-expandWidth animation-delay-[1000ms]"></div>
      </div>
    </div>
  </div>
</div>
