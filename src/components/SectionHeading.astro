---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="relative overflow-hidden py-4 px-4 max-w-[500px] w-full mx-auto rounded-full border border-slate-600 hover:border-purple-500 transition-all duration-500 shadow-lg shadow-slate-600/20 hover:shadow-purple-500/30 hover:shadow-xl">
  
  <!-- グラデーション背景 -->
  <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-gray-900 to-black opacity-95 rounded-full">
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/30 rounded-full"></div>
  </div>

  <!-- ホログラフィックデータストリーム -->
  <div class="absolute inset-0 opacity-30">
    <div class="absolute top-5 left-9 w-2 h-2 bg-slate-400 rounded-full animate-ping shadow-lg shadow-slate-400/50"></div>
    <div class="absolute top-5 right-14 w-2 h-2 bg-purple-400 rounded-full animate-pulse delay-100 shadow-lg shadow-purple-400/50"></div>
    <div class="absolute bottom-5 left-14 w-2 h-2 bg-gray-400 rounded-full animate-bounce delay-200 shadow-lg shadow-gray-400/50"></div>
    <div class="absolute bottom-5 right-9 w-2 h-2 bg-pink-400 rounded-full animate-ping delay-300 shadow-lg shadow-pink-400/50"></div>
  </div>

  <!-- ライン -->
  <div class="absolute inset-0 opacity-40">
    <div class="absolute top-1/2 left-0 right-0 h-px bg-gradient-to-r from-transparent via-slate-500 to-transparent animate-pulse shadow-sm shadow-slate-500/30"></div>
    <div class="absolute top-0 bottom-0 left-1/2 w-px bg-gradient-to-b from-transparent via-purple-500 to-transparent animate-pulse delay-500 shadow-sm shadow-purple-500/30"></div>
  </div>
  
  <!-- ホログラフィックフレーム -->
  <div class="absolute inset-2 border border-slate-400/30 opacity-0 animate-fadeIn delay-500 rounded-full shadow-inner shadow-slate-400/10"></div>

  <!-- メイン -->
  <div class="relative z-10 text-center flex flex-col justify-center">
    
    <!-- タイトル -->
    <h2 class="text-3xl sm:text-5xl font-black text-white opacity-0 animate-fadeInUpGlow drop-shadow-lg">
      {title}
    </h2>
    
    <!-- プログレスバー -->
    <div class="mt-3 flex justify-center">
      <div class="w-[60%] h-0.5 bg-gray-800 rounded-full overflow-hidden shadow-inner">
        <div class="h-full bg-gradient-to-r from-slate-400 via-purple-500 to-pink-500 rounded-full w-0 animate-expandWidth animation-delay-[1000ms] shadow-sm shadow-slate-400/50"></div>
      </div>
    </div>
  </div>
</div>
