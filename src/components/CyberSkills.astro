---
import { Icon } from 'astro-icon/components';
import { getIconName } from '@/utils/icon';
import type { SkillCategory } from '@/types';

interface Props {
  skillCategories: SkillCategory[];
}

const { skillCategories } = Astro.props;
---

<div class="relative mt-6 space-y-8">
  {skillCategories.map((category, categoryIndex) => (
    <div 
      class="opacity-0 translate-y-10 bg-gradient-to-br from-slate-950 to-slate-900 rounded-xl border border-slate-700 overflow-hidden p-4 sm:p-6 relative transition-all duration-800 ease-out"
      style={`animation: fadeIn 0.8s ease-out forwards ${categoryIndex * 0.2}s;`}
    >
      {/* カテゴリヘッダー */}
      <div class="flex items-center mb-6">
        <div class={`w-1 h-8 bg-gradient-to-b ${category.color} mr-4 rounded-full`}></div>
        <h4 class="text-lg sm:text-xl font-bold text-white tracking-wide bg-gradient-to-r from-white via-cyan-400 to-white bg-[length:200%_100%] bg-clip-text text-transparent animate-[shimmer_3s_ease-in-out_infinite]">{category.category}</h4>
        <div class="flex-1 ml-4 h-px bg-gradient-to-r from-slate-600 to-transparent"></div>
      </div>
      
      {/* 背景グリッド */}
      <div class="absolute inset-0 opacity-10">
        <div class="grid grid-cols-6 sm:grid-cols-8 h-full">
          {Array.from({length: 8}).map((_) => (
            <div class="border-r border-cyan-500/20"></div>
          ))}
        </div>
      </div>
      
      {/* 動的スキャンライン */}
      <div class={`absolute top-0 left-0 w-full h-1 bg-gradient-to-r ${category.color} opacity-60 animate-pulse`}></div>
      
      {/* スキルグリッド */}
      <div class="relative z-10 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 sm:gap-4">
        {category.skills.map((skill, index) => (
          <div 
            class="skill-item opacity-0 translate-y-8 scale-75 group relative bg-gradient-to-br from-slate-800/80 to-slate-700/80 backdrop-blur-sm border border-slate-600/50 rounded-lg p-3 sm:p-4 transition-all duration-500 hover:scale-105 hover:shadow-cyan-500/30 hover:border-cyan-400/80 cursor-pointer overflow-hidden hover:shadow-[0_0_20px_rgba(6,182,212,0.8),0_0_30px_rgba(6,182,212,0.6),0_0_40px_rgba(147,51,234,0.4),inset_0_0_20px_rgba(6,182,212,0.2)]"
            style={`animation: fadeIn 0.8s ease-out forwards ${categoryIndex * 0.2 + index * 0.05}s;`}
          >
            {/* マトリックス風デジタル雨エフェクト */}
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="absolute top-0 left-1/4 w-px h-full bg-gradient-to-b from-green-400 to-transparent animate-bounce" style="animation-delay: 0.2s;"></div>
              <div class="absolute top-0 right-1/3 w-px h-full bg-gradient-to-b from-cyan-400 to-transparent animate-bounce" style="animation-delay: 0.5s;"></div>
            </div>
            
            {/* ホログラム風エフェクト */}
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-cyan-400/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 animate-pulse"></div>
            
            {/* スキャンライン効果 */}
            <div class="absolute top-0 left-0 w-0 h-full bg-gradient-to-r from-transparent via-cyan-400/40 to-transparent group-hover:w-full transition-all duration-600 ease-out z-10"></div>
            
            {/* アイコン */}
            <div class="flex justify-center mb-2 sm:mb-3 relative z-20">
              <Icon 
                name={getIconName('devicon', skill.icon)} 
                size={32}
                class="sm:w-9 sm:h-9 transition-all duration-500 group-hover:scale-110 group-hover:rotate-3 filter group-hover:drop-shadow-lg group-hover:drop-shadow-cyan-400/50"
              />
            </div>
            
            {/* スキル名 */}
            <p class="text-sm sm:text-base text-center text-slate-300 group-hover:text-white font-medium transition-all duration-300 relative z-20 group-hover:tracking-wide leading-tight min-h-[2.5rem] sm:min-h-[3rem] flex items-center justify-center">{skill.name}</p>
            
            {/* プログレスバー風エフェクト */}
            <div class={`absolute bottom-0 left-0 w-0 h-1 bg-gradient-to-r ${category.color} group-hover:w-full transition-all duration-700 ease-out`}></div>
            
            {/* コーナーブラケット */}
            <div class="absolute top-1 left-1 w-2 h-2 sm:w-3 sm:h-3 border-t-2 border-l-2 border-cyan-400/60 opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-75 group-hover:scale-100"></div>
            <div class="absolute top-1 right-1 w-2 h-2 sm:w-3 sm:h-3 border-t-2 border-r-2 border-cyan-400/60 opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-75 group-hover:scale-100"></div>
            <div class="absolute bottom-1 left-1 w-2 h-2 sm:w-3 sm:h-3 border-b-2 border-l-2 border-purple-400/60 opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-75 group-hover:scale-100"></div>
            <div class="absolute bottom-1 right-1 w-2 h-2 sm:w-3 sm:h-3 border-b-2 border-r-2 border-purple-400/60 opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-75 group-hover:scale-100"></div>
            
            {/* ネオングロー */}
            <div class={`absolute inset-0 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur-sm bg-gradient-to-br ${category.color.replace('from-', 'from-').replace('to-', 'to-')}/20`}></div>
          </div>
        ))}
      </div>
      
      {/* 追加の装飾エレメント */}
      <div class="absolute top-4 right-4 w-1.5 h-1.5 sm:w-2 sm:h-2 bg-cyan-400 rounded-full animate-ping"></div>
      <div class="absolute bottom-4 left-4 w-1.5 h-1.5 sm:w-2 sm:h-2 bg-purple-400 rounded-full animate-ping" style="animation-delay: 1s;"></div>
    </div>
  ))}
</div>

<style>
  /* Tailwind CSSで表現できないカスタムアニメーション */
  @keyframes fadeIn {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  
  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  /* ホバー時のネオングロー効果 */
  .skill-item:hover {
    box-shadow: 
      0 0 20px rgba(6, 182, 212, 0.8),
      0 0 30px rgba(6, 182, 212, 0.6),
      0 0 40px rgba(147, 51, 234, 0.4),
      inset 0 0 20px rgba(6, 182, 212, 0.2);
  }
</style>
