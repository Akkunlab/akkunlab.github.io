---
import type { SkillCategory } from '@/types';
import SkillCard from './SkillCard.astro';

interface Props {
  skillCategories: SkillCategory[];
}

const { skillCategories } = Astro.props;
---

<div class="relative mt-6 space-y-8">
  {skillCategories.map((category) => (
    <div 
      class="fade-in-text opacity-0 translate-y-8 bg-gradient-to-br from-slate-950 to-slate-900 rounded-xl border border-slate-700 overflow-hidden p-4 sm:p-6 relative transition-all duration-800 ease-out"
    >
      {/* カテゴリヘッダー */}
      <div class="flex items-center mb-6">
        <div class={`w-1 h-8 bg-gradient-to-b ${category.color} mr-4 rounded-full`}></div>
        <h4 class="text-lg sm:text-xl font-bold text-white tracking-wide bg-gradient-to-r from-white via-cyan-400 to-white bg-[length:200%_100%] bg-clip-text text-transparent">{category.category}</h4>
        <div class="flex-1 ml-4 h-px bg-gradient-to-r from-slate-600 to-transparent"></div>
      </div>
      
      {/* 背景グリッド */}
      <div class="absolute inset-0 opacity-10">
        <div class="grid grid-cols-6 sm:grid-cols-8 h-full">
          {Array.from({length: 8}).map((_) => (
            <div class="border-r border-cyan-500/20"></div>
          ))}
        </div>
      </div>
      
      {/* 動的スキャンライン */}
      <div class={`absolute top-0 left-0 w-full h-1 bg-gradient-to-r ${category.color} opacity-60 animate-pulse`}></div>
      
      {/* サブカテゴリーがある場合は見出し付きで表示、なければグリッド */}
      {category.subcategories && category.subcategories.length > 0 ? (
        <div class="relative z-10 space-y-5">
          {category.subcategories.map((sub) => (
            <div>
              <div class="flex items-center mb-3">
                <div class={`w-1 h-5 bg-gradient-to-b ${category.color} mr-3 rounded-full`}></div>
                <h5 class="text-base sm:text-lg font-semibold text-slate-200 tracking-wide">{sub.name}</h5>
                <div class="flex-1 ml-3 h-px bg-gradient-to-r from-slate-600 to-transparent"></div>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6 2xl:grid-cols-8 gap-3 sm:gap-4">
                {sub.skills.map((skill) => (
                  <SkillCard skill={skill} color={category.color} />
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="relative z-10 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6 2xl:grid-cols-8 gap-3 sm:gap-4">
        {category.skills && category.skills.map((skill) => (
          <SkillCard skill={skill} color={category.color} />
        ))}
        </div>
      )}

      {/* 追加の装飾エレメント */}
      <div class="absolute top-4 right-4 w-1.5 h-1.5 sm:w-2 sm:h-2 bg-cyan-400 rounded-full animate-ping"></div>
      <div class="absolute bottom-4 left-4 w-1.5 h-1.5 sm:w-2 sm:h-2 bg-purple-400 rounded-full animate-ping" style="animation-delay: 1s;"></div>
    </div>
  ))}
</div>
