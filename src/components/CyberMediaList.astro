---
import type { NotionRecord } from '@/types/NotionRecord';

interface Props {
  items: NotionRecord[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={['cyber-media-list grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-x-8', className]}>
  {items.map((item) => (
    <article class="cyber-media-item slide-in-right opacity-0 translate-x-8 group">
      <a
        href={item.link}
        class="flex items-center gap-3 sm:gap-4 h-full relative p-3 md:p-4 bg-gradient-to-br from-slate-800/90 to-slate-900/90 backdrop-blur-sm border border-slate-600/50 rounded-lg overflow-hidden group-hover:border-red-400/60 group-hover:-translate-y-0.5 group-hover:shadow-[0_10px_15px_-3px_rgba(0,0,0,0.1),0_4px_6px_-2px_rgba(0,0,0,0.05),0_0_0_1px_rgba(239,68,68,0.2),0_0_25px_rgba(239,68,68,0.3),inset_0_1px_0_rgba(255,255,255,0.1)] transition-all duration-300"
        target="_blank"
        rel="noopener noreferrer"
      >
        {/* ホログラフィック効果 */}
        <div class="absolute inset-0 bg-gradient-to-r from-red-500/10 via-transparent to-orange-500/10 pointer-events-none"></div>

        {/* アニメーション付きスキャンライン */}
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-red-400/15 to-transparent w-0 group-hover:w-full transition-all duration-700 ease-out"></div>

        {/* グロー境界線 */}
        <div class="absolute inset-0 rounded-lg border border-red-400/30 shadow-[0_0_10px_rgba(239,68,68,0.3)] group-hover:shadow-[0_0_20px_rgba(239,68,68,0.5)] transition-all duration-300"></div>

        {/* サムネイル（スキャンビューポート） */}
        <div class="relative z-10 w-36 sm:w-64 flex-shrink-0 aspect-video rounded overflow-hidden bg-slate-950">
          <img
            src={item.image ?? ''}
            alt=""
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          />

          {/* 走査線（ホバー時に画像上を縦に走る） */}
          <div class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-transparent via-red-400/90 to-transparent shadow-[0_0_6px_rgba(239,68,68,0.8)] opacity-0 group-hover:animate-scanY pointer-events-none"></div>

          {/* コーナーブラケット */}
          <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-red-400 opacity-70 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-red-400 opacity-70 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-red-400 opacity-70 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-red-400 opacity-70 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>

        {/* コンテンツ */}
        <div class="relative z-10 flex-1 min-w-0">

          {/* メタ情報 */}
          <div class="flex items-center gap-2 mb-1.5 sm:mb-2">
            <span class="truncate text-xs sm:text-sm text-red-300 font-mono bg-red-400/15 px-2 sm:px-3 py-0.5 rounded-full border border-red-400/30 shadow-[0_0_5px_rgba(239,68,68,0.3)]">
              {item.summary}
            </span>
            <time datetime={item.publish} class="ml-auto flex-shrink-0 text-xs sm:text-sm text-slate-400 font-mono">
              {item.publish ? item.publish.replace(/-/g, '.') : ''}
            </time>
          </div>

          {/* タイトル */}
          <h3 title={item.title} class="text-sm sm:text-base text-primary-content transition-colors duration-300 line-clamp-3">
            {item.title}
          </h3>
        </div>

        {/* ステータスインジケーター */}
        <div class="absolute bottom-2 right-2 z-10 flex items-center space-x-1">
          <div class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></div>
          <div class="w-1 h-1 bg-blue-400 rounded-full animate-[dataFlow_2s_ease-in-out_infinite]"></div>
        </div>
      </a>
    </article>
  ))}
</div>
