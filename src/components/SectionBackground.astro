---
import { Image } from 'astro:assets';
import { IMAGE_FORMAT, IMAGE_QUALITY } from '@/constants';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
}

const { src, alt, eager = false } = Astro.props;
---

<!-- 背景画像 -->
<div class="absolute inset-0 h-[600px] z-0 parallax-bg overflow-hidden">
  <Image
    src={src}
    alt={alt}
    class="w-full h-full object-cover transform transition-transform ease-out duration-1000 will-change-transform"
    widths={[640, 960, 1280, 1536, 1920]}
    sizes="100vw"
    format={IMAGE_FORMAT}
    quality={IMAGE_QUALITY}
    loading={eager ? 'eager' : 'lazy'}
    {...(eager ? { fetchpriority: 'high' } : {})}
  />
  <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-white/80 to-white"></div>
</div>
