---
import { Icon } from 'astro-icon/components'
import { getIconName } from '@/utils/icon'
import { NAV_ITEMS } from '@/constants/siteData'

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/' || currentPath === '';

const isRouteActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return isHomePage;
  return currentPath === href || currentPath.startsWith(href);
};
---

<div class="md:hidden btm-nav rounded-t-xl backdrop-blur-lg shadow-xl bg-header-bg border-t border-header-border z-50"
  style="height: calc(var(--nav-base, 80px) + var(--bottom-extra, 0px)); padding-bottom: env(safe-area-inset-bottom, 0px);">
  {NAV_ITEMS.map((item) => (
    <a 
      class={`group text-primary-content ${isRouteActive(item.href) ? 'is-active' : ''}`}
      href={item.href}
      data-scroll={isHomePage && item.href.startsWith('/#') ? 'true' : 'false'}
    >
      <Icon
        name={getIconName('material-symbols-light', item.icon)}
        class="h-6 w-6 icon-default group-[.is-active]:hidden"
      />
      <Icon
        name={getIconName('material-symbols-light', item.activeIcon)}
        class="h-6 w-6 icon-active hidden group-[.is-active]:block"
      />
      <span class="btm-nav-label">{item.label}</span>
    </a>
  ))}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
  const nav = document.querySelector('.btm-nav');

    if (!nav) return;

    const allLinks = Array.from(nav.querySelectorAll('a'));
    const hashLinks = allLinks.filter(a => (a.getAttribute('href') || '').includes('#'));
    const isHome = location.pathname === '/' || location.pathname === '';

    // Add bottom whitespace when the mobile browser bottom bar disappears (Chrome, etc.).
    const applyViewportInset = () => {
      try {
        const vv = window.visualViewport;
        const bottomInset = vv
          ? Math.max(0, window.innerHeight - (vv.height + vv.offsetTop))
          : 0;
        if (nav instanceof HTMLElement) {
          // When bottomInset is ~0, the browser UI is hidden. Add some extra space.
          const extra = bottomInset <= 1 ? 24 : 0; // px (add more space when bottom bar is hidden)
          nav.style.setProperty('--bottom-extra', `${extra}px`);
        }
      } catch (_) {
        // noop
      }
    };
    applyViewportInset();
    window.visualViewport?.addEventListener('resize', applyViewportInset);
    window.visualViewport?.addEventListener('scroll', applyViewportInset);
    window.addEventListener('orientationchange', applyViewportInset);

    const updateActiveForHash = () => {
      if (!isHome) return;

      const current = location.hash.replace('#', '');

      if (!current) {
        hashLinks.forEach(a => a.classList.remove('is-active'));
        return;
      }

      hashLinks.forEach(a => {
        const href = a.getAttribute('href') || '';
        const anchor = href.split('#')[1];
        a.classList.toggle('is-active', anchor === current);
      });
    };

    updateActiveForHash();

    if (isHome) {
      hashLinks.forEach(a => {
        a.addEventListener('click', () => {
          const href = a.getAttribute('href') || '';
          const anchor = href.split('#')[1];

          if (!anchor) return;

          hashLinks.forEach(l => l.classList.remove('is-active'));
          a.classList.add('is-active');
          history.replaceState(null, '', `#${anchor}`);
        });
      });

      window.addEventListener('hashchange', updateActiveForHash);
    }
  });
</script>
