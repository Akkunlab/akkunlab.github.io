---
import { Icon } from 'astro-icon/components'
import { getIconName } from '@/utils/icon'
import { NAV_ITEMS } from '@/constants/siteData'

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/' || currentPath === '';

const isRouteActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return isHomePage;
  return currentPath === href || currentPath.startsWith(href);
};
---

<div class="md:hidden btm-nav rounded-t-xl backdrop-blur-lg shadow-xl bg-header-bg border-t border-header-border z-[60] fixed left-0 right-0" style="bottom: max(env(safe-area-inset-bottom), 0px); padding-bottom: max(env(safe-area-inset-bottom), 0px);">
  {NAV_ITEMS.map((item) => (
    <a 
      class={`group text-primary-content ${isRouteActive(item.href) ? 'is-active' : ''}`}
      href={item.href}
      data-scroll={isHomePage && item.href.startsWith('/#') ? 'true' : 'false'}
    >
      <Icon
        name={getIconName('material-symbols-light', item.icon)}
        class="h-6 w-6 icon-default group-[.is-active]:hidden"
      />
      <Icon
        name={getIconName('material-symbols-light', item.activeIcon)}
        class="h-6 w-6 icon-active hidden group-[.is-active]:block"
      />
      <span class="btm-nav-label">{item.label}</span>
    </a>
  ))}
</div>

<!-- Spacer to ensure content above isn't hidden behind fixed bottom nav on mobile -->
<div id="btm-nav-spacer" class="md:hidden" aria-hidden="true" style="height: calc(64px + max(env(safe-area-inset-bottom), 0px));"></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('.btm-nav') as HTMLElement | null;

    if (!nav) return;

    const allLinks = Array.from(nav.querySelectorAll('a'));
    const hashLinks = allLinks.filter(a => (a.getAttribute('href') || '').includes('#'));
    const isHome = location.pathname === '/' || location.pathname === '';

    const updateActiveForHash = () => {
      if (!isHome) return;

      const current = location.hash.replace('#', '');

      if (!current) {
        hashLinks.forEach(a => a.classList.remove('is-active'));
        return;
      }

      hashLinks.forEach(a => {
        const href = a.getAttribute('href') || '';
        const anchor = href.split('#')[1];
        a.classList.toggle('is-active', anchor === current);
      });
    };

    updateActiveForHash();

    if (isHome) {
      hashLinks.forEach(a => {
        a.addEventListener('click', () => {
          const href = a.getAttribute('href') || '';
          const anchor = href.split('#')[1];

          if (!anchor) return;

          hashLinks.forEach(l => l.classList.remove('is-active'));
          a.classList.add('is-active');
          history.replaceState(null, '', `#${anchor}`);
        });
      });

      window.addEventListener('hashchange', updateActiveForHash);
    }

    // iOS/Android dynamic toolbar and home indicator handling
    // Use visualViewport to adjust bottom position so buttons stay tappable when toolbars collapse/expand.
  const spacer = document.getElementById('btm-nav-spacer') as HTMLElement | null;

    const applyViewportOffset = () => {
      const vv = window.visualViewport;
      if (!vv) return;
      // Calculate the difference between layout viewport height and visual viewport height
      const toolbarOffset = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
      // Apply as an extra bottom offset in addition to safe-area inset
  nav.style.bottom = `max(env(safe-area-inset-bottom), 0px)`;
  nav.style.transform = `translateY(${-toolbarOffset}px)`; // move up when toolbars overlap
      if (spacer) {
        spacer.style.height = `calc(64px + ${toolbarOffset}px + max(env(safe-area-inset-bottom), 0px))`;
      }
    };

    if ('visualViewport' in window) {
      applyViewportOffset();
      const vvListeners = window.visualViewport;
      if (vvListeners) {
        vvListeners.addEventListener('resize', applyViewportOffset);
        vvListeners.addEventListener('scroll', applyViewportOffset);
      }
    }
  });
</script>
