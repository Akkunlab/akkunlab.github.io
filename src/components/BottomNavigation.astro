---
import { Icon } from 'astro-icon/components'
import { getIconName } from '@/utils/icon'
import { NAV_ITEMS } from '@/constants/siteData'
import { isHomePath, scrollAttr } from '@/utils/nav';

const currentPath = Astro.url.pathname;
const isHomePage = isHomePath(currentPath);

const isRouteActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return isHomePage;
  return currentPath === href || currentPath.startsWith(href);
};
---

<div
  class="md:hidden btm-nav rounded-t-xl backdrop-blur-lg shadow-xl bg-header-bg border-t border-header-border z-50  min-w-[360px]"
  style="
    /* Base fallback when env() is not supported */
    height: 64px;
    padding-bottom: 0;

    /* iOS 11-12 legacy syntax */
    height: calc(64px + constant(safe-area-inset-bottom));
    padding-bottom: constant(safe-area-inset-bottom);

    /* Modern browsers (iOS 11.2+, Safari, Chrome on iOS with viewport-fit=cover) */
    height: calc(64px + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
  "
>
  {NAV_ITEMS.map((item) => (
    <a 
      class={`group text-primary-content ${isRouteActive(item.href) ? 'is-active' : ''}`}
      href={item.href}
      data-scroll={scrollAttr(currentPath, item.href)}
    >
      <Icon
        name={getIconName('material-symbols-light', item.icon)}
        class="h-6 w-6 icon-default group-[.is-active]:hidden"
      />
      <Icon
        name={getIconName('material-symbols-light', item.activeIcon)}
        class="h-6 w-6 icon-active hidden group-[.is-active]:block"
      />
      <span class="btm-nav-label block truncate">{item.label}</span>
    </a>
  ))}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('.btm-nav');

    if (!nav) return;

    const allLinks = Array.from(nav.querySelectorAll('a'));
    const hashLinks = allLinks.filter(a => (a.getAttribute('href') || '').includes('#'));
    const isHome = location.pathname === '/' || location.pathname === '';

    const updateActiveForHash = () => {
      if (!isHome) return;

      const current = location.hash.replace('#', '');

      if (!current) {
        hashLinks.forEach(a => a.classList.remove('is-active'));
        return;
      }

      hashLinks.forEach(a => {
        const href = a.getAttribute('href') || '';
        const anchor = href.split('#')[1];
        a.classList.toggle('is-active', anchor === current);
      });
    };

    updateActiveForHash();

    if (isHome) {
      hashLinks.forEach(a => {
        a.addEventListener('click', () => {
          const href = a.getAttribute('href') || '';
          const anchor = href.split('#')[1];

          if (!anchor) return;

          hashLinks.forEach(l => l.classList.remove('is-active'));
          a.classList.add('is-active');
          history.replaceState(null, '', `#${anchor}`);
        });
      });

      window.addEventListener('hashchange', updateActiveForHash);
    }
  });
</script>
