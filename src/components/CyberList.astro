---
import type { NotionRecord } from '@/types/NotionRecord';

interface Props {
  items: NotionRecord[];
  class?: string;
}

const { items, class: className } = Astro.props;
const records = items.filter(item => item.name);
---

<ul class:list={['cyber-list grid grid-cols-1 gap-3 lg:grid-cols-2 lg:gap-x-8 sm:pl-4', className]}>
  {records.map((item) => (
    <li class="cyber-list-item relative slide-in-right opacity-0 translate-x-8 group">

      {/* 背景グロー効果 */}
      <div class="absolute -inset-1 bg-gradient-to-r from-blue-600/20 via-cyan-600/20 to-blue-600/20 rounded-lg blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

      <div class="relative flex items-center">

        {/* 左のライン */}
        <div class="absolute left-6 top-0 w-px h-full bg-gradient-to-b from-blue-400/30 via-cyan-400/50 to-blue-400/30"></div>

        <div class="cyber-bullet relative z-10 w-3 h-3 mr-4 flex-shrink-0">

          {/* メインブレット */}
          <div class="absolute inset-0 bg-gradient-to-br from-blue-400 via-cyan-400 to-blue-500 rounded-full shadow-[0_0_8px_rgba(59,130,246,0.7)] animate-pulse">
            <div class="absolute inset-0.5 bg-gradient-to-br from-white/40 via-cyan-300/30 to-transparent rounded-full"></div>
          </div>

          {/* 外側のリング1 */}
          <div class="absolute -inset-1 rounded-full border border-blue-400/40 group-hover:border-cyan-400/60 group-hover:scale-150 transition-all duration-500"></div>

          {/* 外側のリング2 */}
          <div class="absolute -inset-2 rounded-full border border-blue-400/20 group-hover:border-cyan-400/40 group-hover:scale-200 transition-all duration-700 delay-100"></div>

          {/* パルス効果 */}
          <div class="absolute -inset-3 rounded-full bg-blue-400/10 group-hover:bg-cyan-400/20 group-hover:scale-300 transition-all duration-1000 opacity-0 group-hover:opacity-100"></div>
        </div>

        <div class="cyber-content flex-1 relative overflow-hidden rounded-lg border border-slate-600/50 bg-gradient-to-r from-slate-800/90 via-slate-900/90 to-slate-800/90 backdrop-blur-sm group-hover:border-blue-400/70 group-hover:shadow-[0_0_20px_rgba(59,130,246,0.3)] group-hover:translate-x-1 transition-all duration-300">

          {/* 上部のスキャンライン */}
          <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-cyan-400/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          {/* メインホログラフィック効果 */}
          <div class="absolute inset-0 bg-gradient-to-r from-blue-500/10 via-cyan-500/10 to-blue-500/10 pointer-events-none"></div>

          {/* アニメーション付きスキャンライン */}
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-cyan-400/20 to-transparent w-0 group-hover:w-full transition-all duration-700 ease-out"></div>

          {/* データフロー効果 */}
          <div class="absolute top-1 left-0 w-0 h-px bg-gradient-to-r from-blue-400 to-cyan-400 group-hover:w-full transition-all duration-500 delay-200"></div>
          <div class="absolute bottom-1 right-0 w-0 h-px bg-gradient-to-l from-blue-400 to-cyan-400 group-hover:w-full transition-all duration-500 delay-400"></div>

          <div class="relative z-10 p-4 sm:p-5 flex items-center justify-between gap-3">

            {/* keep-all: 資格名が単語の途中で折り返されるのを防ぐ */}
            <span class="text-primary-content [word-break:keep-all] group-hover:[text-shadow:0_0_8px_rgba(255,255,255,0.5)] transition-all duration-300">
              {item.name}
            </span>

            <div class="flex items-center gap-3 flex-shrink-0">
              {item.date && (
                <time datetime={item.date} class="text-sm text-cyan-300/80 font-mono tracking-wider">
                  {item.date.split('-')[0]}
                </time>
              )}
              {/* ホバー時にしか見えない装飾のため、タッチ端末では表示しない */}
              <div class="hidden sm:flex items-center space-x-2">

                {/* データドット */}
                <div class="w-1 h-1 bg-green-400 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-300 animate-pulse"></div>
                <div class="w-1 h-1 bg-cyan-400 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-400 animate-pulse"></div>
                <div class="w-1 h-1 bg-blue-400 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-500 animate-pulse"></div>

                {/* 右端のアクセント矢印 */}
                <div class="w-0 h-0 border-l-4 border-l-cyan-400 border-t-2 border-t-transparent border-b-2 border-b-transparent opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300 delay-200"></div>
              </div>
            </div>
          </div>

          {/* 下部のグロー */}
          <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-px bg-gradient-to-r from-blue-400 to-cyan-400 group-hover:w-3/4 transition-all duration-500 delay-300 blur-sm"></div>

          {/* コーナーアクセント */}
          <div class="absolute top-1 left-1 w-2 h-2 border-t border-l border-cyan-400/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute bottom-1 right-1 w-2 h-2 border-b border-r border-cyan-400/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
      </div>
    </li>
  ))}
</ul>
