---
import CyberListItem from '@/components/CyberListItem.astro';

interface Props {
  items: string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class={`cyber-list space-y-3 max-w-[575px] pl-4 ${className}`}>
  {items.map((item) => (
    <li class="cyber-list-item slide-in-right opacity-0 translate-x-8 group">
      <CyberListItem scope="group">{item}</CyberListItem>
    </li>
  ))}
</ul>
