---
import CyberListItem from '@/components/CyberListItem.astro';

interface Props {
  items: string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['cyber-list grid grid-cols-1 gap-3 lg:grid-cols-2 lg:gap-x-8 pl-4', className]}>
  {items.map((item) => (
    <li class="cyber-list-item slide-in-right opacity-0 translate-x-8 group">
      <CyberListItem scope="group">{item}</CyberListItem>
    </li>
  ))}
</ul>
