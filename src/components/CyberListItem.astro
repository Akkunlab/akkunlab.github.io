---
/**
 * サイバー風リストアイテムの内部マークアップ。
 * CyberList / CyberCollapse で共通利用する。
 *
 * hover のスコープ（group / group/item）はコンポーネントごとに異なるため、
 * Tailwind の JIT がクラスを生成できるよう、補間せずに完全なクラス文字列を
 * リテラルとして両方定義し、scope で選択する。
 */
interface Props {
  scope?: 'group' | 'item';
  bold?: boolean;
}

const { scope = 'group', bold = false } = Astro.props;

const variants = {
  group: {
    glow: 'absolute -inset-1 bg-gradient-to-r from-blue-600/20 via-cyan-600/20 to-blue-600/20 rounded-lg blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500',
    ring1: 'absolute -inset-1 rounded-full border border-blue-400/40 group-hover:border-cyan-400/60 group-hover:scale-150 transition-all duration-500',
    ring2: 'absolute -inset-2 rounded-full border border-blue-400/20 group-hover:border-cyan-400/40 group-hover:scale-200 transition-all duration-700 delay-100',
    pulse: 'absolute -inset-3 rounded-full bg-blue-400/10 group-hover:bg-cyan-400/20 group-hover:scale-300 transition-all duration-1000 opacity-0 group-hover:opacity-100',
    box: 'cyber-content flex-1 relative overflow-hidden rounded-lg border border-slate-600/50 bg-gradient-to-r from-slate-800/90 via-slate-900/90 to-slate-800/90 backdrop-blur-sm group-hover:border-blue-400/70 group-hover:shadow-[0_0_20px_rgba(59,130,246,0.3)] group-hover:translate-x-1 transition-all duration-300',
    scanTop: 'absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-cyan-400/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300',
    scanFull: 'absolute inset-0 bg-gradient-to-r from-transparent via-cyan-400/20 to-transparent w-0 group-hover:w-full transition-all duration-700 ease-out',
    flowTop: 'absolute top-1 left-0 w-0 h-px bg-gradient-to-r from-blue-400 to-cyan-400 group-hover:w-full transition-all duration-500 delay-200',
    flowBottom: 'absolute bottom-1 right-0 w-0 h-px bg-gradient-to-l from-blue-400 to-cyan-400 group-hover:w-full transition-all duration-500 delay-400',
    text: 'text-primary-content group-hover:text-shadow-[0_0_8px_rgba(255,255,255,0.5)] transition-all duration-300',
    dot1: 'w-1 h-1 bg-green-400 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-300 animate-pulse',
    dot2: 'w-1 h-1 bg-cyan-400 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-400 animate-pulse',
    dot3: 'w-1 h-1 bg-blue-400 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-500 animate-pulse',
    arrow: 'w-0 h-0 border-l-4 border-l-cyan-400 border-t-2 border-t-transparent border-b-2 border-b-transparent opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300 delay-200',
    glowBottom: 'absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-px bg-gradient-to-r from-blue-400 to-cyan-400 group-hover:w-3/4 transition-all duration-500 delay-300 blur-sm',
    cornerTop: 'absolute top-1 left-1 w-2 h-2 border-t border-l border-cyan-400/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300',
    cornerBottom: 'absolute bottom-1 right-1 w-2 h-2 border-b border-r border-cyan-400/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300',
  },
  item: {
    glow: 'absolute -inset-1 bg-gradient-to-r from-blue-600/20 via-cyan-600/20 to-blue-600/20 rounded-lg blur-sm opacity-0 group-hover/item:opacity-100 transition-opacity duration-500',
    ring1: 'absolute -inset-1 rounded-full border border-blue-400/40 group-hover/item:border-cyan-400/60 group-hover/item:scale-150 transition-all duration-500',
    ring2: 'absolute -inset-2 rounded-full border border-blue-400/20 group-hover/item:border-cyan-400/40 group-hover/item:scale-200 transition-all duration-700 delay-100',
    pulse: 'absolute -inset-3 rounded-full bg-blue-400/10 group-hover/item:bg-cyan-400/20 group-hover/item:scale-300 transition-all duration-1000 opacity-0 group-hover/item:opacity-100',
    box: 'cyber-content flex-1 relative overflow-hidden rounded-lg border border-slate-600/50 bg-gradient-to-r from-slate-800/90 via-slate-900/90 to-slate-800/90 backdrop-blur-sm group-hover/item:border-blue-400/70 group-hover/item:shadow-[0_0_20px_rgba(59,130,246,0.3)] group-hover/item:translate-x-1 transition-all duration-300',
    scanTop: 'absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-cyan-400/60 to-transparent opacity-0 group-hover/item:opacity-100 transition-opacity duration-300',
    scanFull: 'absolute inset-0 bg-gradient-to-r from-transparent via-cyan-400/20 to-transparent w-0 group-hover/item:w-full transition-all duration-700 ease-out',
    flowTop: 'absolute top-1 left-0 w-0 h-px bg-gradient-to-r from-blue-400 to-cyan-400 group-hover/item:w-full transition-all duration-500 delay-200',
    flowBottom: 'absolute bottom-1 right-0 w-0 h-px bg-gradient-to-l from-blue-400 to-cyan-400 group-hover/item:w-full transition-all duration-500 delay-400',
    text: 'text-primary-content group-hover/item:text-shadow-[0_0_8px_rgba(255,255,255,0.5)] transition-all duration-300',
    dot1: 'w-1 h-1 bg-green-400 rounded-full opacity-0 group-hover/item:opacity-100 transition-opacity duration-300 delay-300 animate-pulse',
    dot2: 'w-1 h-1 bg-cyan-400 rounded-full opacity-0 group-hover/item:opacity-100 transition-opacity duration-300 delay-400 animate-pulse',
    dot3: 'w-1 h-1 bg-blue-400 rounded-full opacity-0 group-hover/item:opacity-100 transition-opacity duration-300 delay-500 animate-pulse',
    arrow: 'w-0 h-0 border-l-4 border-l-cyan-400 border-t-2 border-t-transparent border-b-2 border-b-transparent opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all duration-300 delay-200',
    glowBottom: 'absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-px bg-gradient-to-r from-blue-400 to-cyan-400 group-hover/item:w-3/4 transition-all duration-500 delay-300 blur-sm',
    cornerTop: 'absolute top-1 left-1 w-2 h-2 border-t border-l border-cyan-400/50 opacity-0 group-hover/item:opacity-100 transition-opacity duration-300',
    cornerBottom: 'absolute bottom-1 right-1 w-2 h-2 border-b border-r border-cyan-400/50 opacity-0 group-hover/item:opacity-100 transition-opacity duration-300',
  },
};

const v = variants[scope];
const textClass = bold ? v.text.replace('text-primary-content', 'text-primary-content font-medium') : v.text;
---

{/* 背景グロー効果 */}
<div class={v.glow}></div>

{/* メインコンテナ */}
<div class="relative flex items-center">

  {/* 左のライン */}
  <div class="absolute left-6 top-0 w-px h-full bg-gradient-to-b from-blue-400/30 via-cyan-400/50 to-blue-400/30"></div>

  {/* アイコン/ブレット */}
  <div class="cyber-bullet relative z-10 w-3 h-3 mr-4 flex-shrink-0">

    {/* メインブレット */}
    <div class="absolute inset-0 bg-gradient-to-br from-blue-400 via-cyan-400 to-blue-500 rounded-full shadow-[0_0_8px_rgba(59,130,246,0.7)] animate-pulse">
      <div class="absolute inset-0.5 bg-gradient-to-br from-white/40 via-cyan-300/30 to-transparent rounded-full"></div>
    </div>

    {/* 外側のリング1 */}
    <div class={v.ring1}></div>

    {/* 外側のリング2 */}
    <div class={v.ring2}></div>

    {/* パルス効果 */}
    <div class={v.pulse}></div>
  </div>

  {/* コンテンツボックス */}
  <div class={v.box}>

    {/* 上部のスキャンライン */}
    <div class={v.scanTop}></div>

    {/* メインホログラフィック効果 */}
    <div class="absolute inset-0 bg-gradient-to-r from-blue-500/10 via-cyan-500/10 to-blue-500/10 pointer-events-none"></div>

    {/* アニメーション付きスキャンライン */}
    <div class={v.scanFull}></div>

    {/* データフロー効果 */}
    <div class={v.flowTop}></div>
    <div class={v.flowBottom}></div>

    {/* コンテンツ */}
    <div class="relative z-10 p-4 flex items-center justify-between">

      {/* テキスト */}
      <span class={textClass}>
        <slot />
      </span>

      {/* ステータスインジケーター */}
      <div class="flex items-center space-x-2">

        {/* データドット */}
        <div class={v.dot1}></div>
        <div class={v.dot2}></div>
        <div class={v.dot3}></div>

        {/* 右端のアクセント矢印 */}
        <div class={v.arrow}></div>
      </div>
    </div>

    {/* 下部のグロー */}
    <div class={v.glowBottom}></div>

    {/* コーナーアクセント */}
    <div class={v.cornerTop}></div>
    <div class={v.cornerBottom}></div>
  </div>
</div>
