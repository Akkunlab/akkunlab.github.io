---
import { Icon } from 'astro-icon/components';
import { getIconName } from '@/utils/icon'

interface Props {
  title: string;
  items: Array<{
    name: string;
    date: string;
  }>;
  class?: string;
}

const { title, items, class: className } = Astro.props;
---

<div class={`cyber-collapse max-w-[575px] fade-in-text opacity-0 translate-y-8 group ${className}`}>
  <div class="collapse bg-transparent">
    <input type="checkbox" aria-label="checkbox" />
    
    <!-- タイトル部分 -->
    <div class="collapse-title px-0 py-3 relative group cursor-pointer">
      <div class="cyber-collapse-header relative p-3 bg-gradient-to-r from-slate-800/90 via-slate-900/90 to-slate-800/90 backdrop-blur-sm border border-slate-600/40 rounded-lg overflow-hidden group-hover:border-cyan-400/60 group-hover:-translate-y-px group-hover:shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-1px_rgba(0,0,0,0.06),0_0_0_1px_rgba(34,211,238,0.2),0_0_15px_rgba(34,211,238,0.3),inset_0_1px_0_rgba(255,255,255,0.1)] transition-all duration-300">
        
        <!-- ホログラフィック効果 -->
        <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/5 via-transparent to-blue-500/5 pointer-events-none"></div>
        
        <!-- アニメーション付きスキャンライン -->
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-cyan-400/10 to-transparent w-0 group-hover:w-full transition-all duration-500 ease-out"></div>
        
        <!-- グロー境界線 -->
        <div class="absolute inset-0 rounded-lg border border-cyan-400/30 shadow-[0_0_8px_rgba(34,211,238,0.3)] group-hover:shadow-[0_0_15px_rgba(34,211,238,0.4)] transition-all duration-300"></div>
        
        <!-- 角のアクセント -->
        <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-cyan-400 opacity-60 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-cyan-400 opacity-60 group-hover:opacity-100 transition-opacity duration-300"></div>
        
        <!-- アイコンとテキスト -->
        <div class="relative z-10 flex items-center justify-between">
          <span class="text-slate-200 group-hover:text-white font-medium transition-colors duration-300">
            {title}
          </span>
          
          <!-- 展開アイコン -->
          <div class="w-8 h-8 text-cyan-400 collapse-arrow transition-transform duration-300">
            <Icon name={getIconName('material-symbols-light', 'keyboard-arrow-down')} size={32} class="text-cyan-400 transition-transform duration-300" />
          </div>
        </div>
      </div>
    </div>
    
    <!-- コンテンツ部分 -->
    <div class="collapse-content px-0 pb-4">
      <div class="cyber-collapse-content mt-2 p-4 bg-white rounded-lg relative overflow-hidden">
        
        <!-- リスト -->
        <ul class="space-y-3">
          {items.map((item) => (
            <li class="cyber-list-item fade-in-text opacity-0 translate-y-8 relative group/item">
              
              {/* 背景グロー効果 */}
              <div class="absolute -inset-1 bg-gradient-to-r from-blue-600/20 via-cyan-600/20 to-blue-600/20 rounded-lg blur-sm opacity-0 group-hover/item:opacity-100 transition-opacity duration-500"></div>
              
              {/* メインコンテナ */}
              <div class="relative flex items-center">
                
                {/* 左のライン */}
                <div class="absolute left-6 top-0 w-px h-full bg-gradient-to-b from-blue-400/30 via-cyan-400/50 to-blue-400/30"></div>
                
                {/* アイコン/ブレット */}
                <div class="cyber-bullet relative z-10 w-3 h-3 mr-4 flex-shrink-0">
                  
                  {/* メインブレット */}
                  <div class="absolute inset-0 bg-gradient-to-br from-blue-400 via-cyan-400 to-blue-500 rounded-full shadow-[0_0_8px_rgba(59,130,246,0.7)] animate-pulse">
                    <div class="absolute inset-0.5 bg-gradient-to-br from-white/40 via-cyan-300/30 to-transparent rounded-full"></div>
                  </div>
                  
                  {/* 外側のリング1 */}
                  <div class="absolute -inset-1 rounded-full border border-blue-400/40 group-hover/item:border-cyan-400/60 group-hover/item:scale-150 transition-all duration-500"></div>
                  
                  {/* 外側のリング2 */}
                  <div class="absolute -inset-2 rounded-full border border-blue-400/20 group-hover/item:border-cyan-400/40 group-hover/item:scale-200 transition-all duration-700 delay-100"></div>
                  
                  {/* パルス効果 */}
                  <div class="absolute -inset-3 rounded-full bg-blue-400/10 group-hover/item:bg-cyan-400/20 group-hover/item:scale-300 transition-all duration-1000 opacity-0 group-hover/item:opacity-100"></div>
                </div>
                
                {/* コンテンツボックス */}
                <div class="cyber-content flex-1 relative overflow-hidden rounded-lg border border-slate-600/50 bg-gradient-to-r from-slate-800/90 via-slate-900/90 to-slate-800/90 backdrop-blur-sm group-hover/item:border-blue-400/70 group-hover/item:shadow-[0_0_20px_rgba(59,130,246,0.3)] group-hover/item:translate-x-1 transition-all duration-300">
                  
                  {/* 上部のスキャンライン */}
                  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-cyan-400/60 to-transparent opacity-0 group-hover/item:opacity-100 transition-opacity duration-300"></div>
                  
                  {/* メインホログラフィック効果 */}
                  <div class="absolute inset-0 bg-gradient-to-r from-blue-500/10 via-cyan-500/10 to-blue-500/10 pointer-events-none"></div>
                  
                  {/* アニメーション付きスキャンライン */}
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-cyan-400/20 to-transparent w-0 group-hover/item:w-full transition-all duration-700 ease-out"></div>
                  
                  {/* データフロー効果 */}
                  <div class="absolute top-1 left-0 w-0 h-px bg-gradient-to-r from-blue-400 to-cyan-400 group-hover/item:w-full transition-all duration-500 delay-200"></div>
                  <div class="absolute bottom-1 right-0 w-0 h-px bg-gradient-to-l from-blue-400 to-cyan-400 group-hover/item:w-full transition-all duration-500 delay-400"></div>
                  
                  {/* コンテンツ */}
                  <div class="relative z-10 p-4 flex items-center justify-between">
                    
                    {/* テキスト */}
                    <span class="text-dark-text font-medium group-hover/item:text-primary-content group-hover/item:text-shadow-[0_0_8px_rgba(255,255,255,0.5)] transition-all duration-300">
                      {item.date} {item.name}
                    </span>
                    
                    {/* ステータスインジケーター */}
                    <div class="flex items-center space-x-2">
                      
                      {/* データドット */}
                      <div class="w-1 h-1 bg-green-400 rounded-full opacity-0 group-hover/item:opacity-100 transition-opacity duration-300 delay-300 animate-pulse"></div>
                      <div class="w-1 h-1 bg-cyan-400 rounded-full opacity-0 group-hover/item:opacity-100 transition-opacity duration-300 delay-400 animate-pulse"></div>
                      <div class="w-1 h-1 bg-blue-400 rounded-full opacity-0 group-hover/item:opacity-100 transition-opacity duration-300 delay-500 animate-pulse"></div>
                      
                      {/* 右端のアクセント矢印 */}
                      <div class="w-0 h-0 border-l-4 border-l-cyan-400 border-t-2 border-t-transparent border-b-2 border-b-transparent opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all duration-300 delay-200"></div>
                    </div>
                  </div>
                  
                  {/* 下部のグロー */}
                  <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-px bg-gradient-to-r from-blue-400 to-cyan-400 group-hover/item:w-3/4 transition-all duration-500 delay-300 blur-sm"></div>
                  
                  {/* コーナーアクセント */}
                  <div class="absolute top-1 left-1 w-2 h-2 border-t border-l border-cyan-400/50 opacity-0 group-hover/item:opacity-100 transition-opacity duration-300"></div>
                  <div class="absolute bottom-1 right-1 w-2 h-2 border-b border-r border-cyan-400/50 opacity-0 group-hover/item:opacity-100 transition-opacity duration-300"></div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', (): void => {
    const collapseElements: NodeListOf<Element> = document.querySelectorAll('.cyber-collapse .collapse');
    
    collapseElements.forEach((collapse: Element): void => {
      const checkbox: HTMLInputElement | null = collapse.querySelector('input[type="checkbox"]');
      const icon: HTMLElement | null = collapse.querySelector('.collapse-arrow');
      
      if (checkbox && icon) {
        checkbox.addEventListener('change', (event: Event): void => {
          const target = event.target as HTMLInputElement;
          icon.style.transform = `rotate(${target.checked ? 180 : 0}deg)`;
        });
      }
    });
  });
</script>
