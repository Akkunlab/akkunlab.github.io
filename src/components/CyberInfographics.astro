---
import { Icon } from 'astro-icon/components'
import { getIconName } from '@/utils/icon'

export interface Props {
  title: string;
  icon: string;
  count: number;
  color: 'cyan' | 'purple' | 'orange' | 'green';
}

const { title, icon, count, color } = Astro.props;

const colorConfig = {
  cyan: {
    primary: 'cyan-500',
    secondary: 'blue-500',
    accent: 'cyan-400',
    text: 'cyan-400',
    textGlow: 'cyan-300',
    shadow: 'cyan-500/30',
    border: 'cyan-500/30',
    hoverBorder: 'cyan-500/60',
    hoverShadow: 'cyan-500/40',
    via: 'cyan-900'
  },
  purple: {
    primary: 'purple-500',
    secondary: 'pink-500',
    accent: 'purple-400',
    text: 'purple-400',
    textGlow: 'purple-300',
    shadow: 'purple-500/30',
    border: 'purple-500/30',
    hoverBorder: 'purple-500/60',
    hoverShadow: 'purple-500/40',
    via: 'purple-900'
  },
  orange: {
    primary: 'orange-500',
    secondary: 'red-500',
    accent: 'orange-400',
    text: 'orange-400',
    textGlow: 'orange-300',
    shadow: 'orange-500/30',
    border: 'orange-500/30',
    hoverBorder: 'orange-500/60',
    hoverShadow: 'orange-500/40',
    via: 'orange-900'
  },
  green: {
    primary: 'green-500',
    secondary: 'emerald-500',
    accent: 'green-400',
    text: 'green-400',
    textGlow: 'green-300',
    shadow: 'green-500/30',
    border: 'green-500/30',
    hoverBorder: 'green-500/60',
    hoverShadow: 'green-500/40',
    via: 'green-900'
  }
};

const colors = colorConfig[color];
---

<div class="group relative transform hover:scale-110 transition-all duration-700 infographic-card" data-count={count}>
  <div class={`bg-gradient-to-br from-slate-900 via-${colors.via} to-slate-900 p-12 rounded-2xl border-2 border-${colors.border} hover:border-${colors.hoverBorder} transition-all duration-500 hover:shadow-2xl hover:shadow-${colors.hoverShadow} overflow-hidden relative`}>

    <!-- サイバーフレーム -->
    <div class={`absolute inset-0 bg-gradient-to-r from-${colors.primary}/5 to-${colors.secondary}/5 rounded-2xl opacity-0 group-hover:opacity-100 transition-all duration-500`}></div>
    <div class={`absolute top-0 left-0 w-full h-full border-2 border-transparent bg-gradient-to-br from-${colors.accent}/10 via-transparent to-${colors.accent}/10 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-700`}></div>
    
    <!-- 強化されたスキャンライン -->
    <div class={`absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-${colors.accent} to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-scanLine`}></div>
    <div class={`absolute bottom-0 right-0 w-full h-1 bg-gradient-to-l from-transparent via-${colors.accent} to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-scanLine`} style="animation-delay: 0.3s;"></div>
    
    <!-- コーナーアクセント -->
    <div class={`absolute top-2 left-2 w-6 h-6 border-t-2 border-l-2 border-${colors.accent} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
    <div class={`absolute bottom-2 right-2 w-6 h-6 border-b-2 border-r-2 border-${colors.accent} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
    
    <!-- アイコン -->
    <div class="relative text-center mb-8">
      <div class={`inline-flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-r from-${colors.primary} to-${colors.secondary} mb-6 group-hover:animate-glow group-hover:scale-110 transition-transform duration-500 shadow-2xl shadow-${colors.shadow}`}>
        <Icon name={getIconName('material-symbols-light', icon)} class="h-12 w-12 text-white" />
      </div>
    </div>
    
    <!-- 数値 -->
    <div class="text-center relative z-10">
      <div class={`text-7xl font-bold text-${colors.text} mb-4 relative counter-number`}>
        0
        <div class={`absolute inset-0 text-${colors.textGlow} opacity-20 blur-sm counter-glow`}>0</div>
      </div>
      <div class="text-2xl font-semibold text-dark-text mb-3 tracking-wider">{title}</div>
    </div>
    
    <!-- 進行バー -->
    <div class="mt-8 relative">
      <div class="w-full h-2 bg-slate-700 rounded-full overflow-hidden shadow-inner">
        <div class={`progress-bar h-full bg-gradient-to-r from-${colors.primary} to-${colors.secondary} rounded-full shadow-lg shadow-${colors.shadow}`} style="width: 0%;"></div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const cards = document.querySelectorAll('.infographic-card');
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const card = entry.target as HTMLElement;
        const counterElement = card.querySelector('.counter-number');
        const counterGlow = card.querySelector('.counter-glow');
        const progressBar = card.querySelector('.progress-bar') as HTMLElement;
        const targetCount = parseInt(card.getAttribute('data-count') || '0');
        
        animateCounter(counterElement, counterGlow, progressBar, targetCount);
      }
    });
  }, { threshold: 0.3 });
  
  cards.forEach(card => {
    observer.observe(card);
    
    card.addEventListener('mouseenter', function(this: HTMLElement) {
      const counterElement = this.querySelector('.counter-number');
      const counterGlow = this.querySelector('.counter-glow');
      const progressBar = this.querySelector('.progress-bar') as HTMLElement;
      const targetCount = parseInt(this.getAttribute('data-count') || '0');
      
      animateCounter(counterElement, counterGlow, progressBar, targetCount);
    });
  });
  
  function animateCounter(counterElement: Element | null, counterGlow: Element | null, progressBar: HTMLElement, targetCount: number) {
    if (!counterElement || !counterGlow || !progressBar) return;
    
    let startTime: number | null = null;
    const duration = 2000;
    
    // イージングアウト関数
    function easeOutQuart(t: number): number {
      return 1 - Math.pow(1 - t, 4);
    }
    
    function animate(currentTime: number) {
      if (startTime === null) startTime = currentTime;
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);

      const easedProgress = easeOutQuart(progress);
      const currentCount = Math.round(easedProgress * targetCount);

      if (counterElement) counterElement.textContent = currentCount;
      if (counterGlow) counterGlow.textContent = currentCount;

      const progressPercent = (currentCount / targetCount) * 100;
      progressBar.style.width = progressPercent + '%';
      
      if (progress < 1) {
        requestAnimationFrame(animate);
      }
    }
    
    requestAnimationFrame(animate);
  }
});
</script>
