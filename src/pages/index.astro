    url: 'https://prtimes.jp/main/html/rd/p/000000001.000106546.html',
  }, {
    title: '自律走行ロボットで競う学生対抗「AWSロボットデリバリーチャレンジ」予選トップ通過チームにインタビュー　速く走るポイントは',
    source: 'ロボスタ',
    date: '2021.4.26',
    url: 'https://robotstart.info/2021/04/26/aws-rdc-int.html',
  },
];

const socialLinks = await fetchNotionPageList(SOCIAL_LINKS_DATABASE_ID);
const certifications = await fetchNotionPageList(CERTIFICATIONS_DATABASE_ID, {
  sorts: [{ property: 'date', direction: 'descending' }]
});

const sectionClass = 'py-40 px-4 md:px-16';
---

<Layout showSplash={true}>
  
  <!-- ヒーローセクション -->
  <section class="relative h-screen">
    <HeroCarousel />
    <div class="absolute inset-0 flex items-end pl-[3%] pb-[200px] md:pb-8">
      <h2 class="text-4xl sm:text-6xl lg:text-8xl font-bold text-primary-content hero-text">
        {HERO_TITLE_LINES.map((line, index) => (
          <span class="block bg-base-300 pt-0 pb-1 sm:pb-3 px-2 sm:px-5 m-3 w-fit invisible" style={`animation-delay: ${0.5 + index * 0.7}s;`} data-index={index}>
            {line}
          </span>
        ))}
      </h2>
    </div>
  </section>

  <!-- 作品セクション -->
  <section id="works" class={sectionClass}>
    <SectionHeading title="作品" />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-20 mb-12">
      {works.map((work) => (
        <article class="work-item">
          <a href={work.link} class="card card-item">
            <AnimatedImage src={heroImage_1} alt={work.title} />
            <div class="card-body p-0 pt-2">
              <h2 class="card-title fade-in-text opacity-0 translate-y-8">{work.title}</h2>
              <p class="fade-in-text opacity-0 translate-y-8">{work.summary}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div class="flex justify-center">
      <Button text="もっと見てみる！" href="/works" type="arrow-forward" />
    </div>
  </section>

  <!-- 活動セクション -->
  <section id="activities" class=`${sectionClass} relative`>
    
    <!-- 背景画像 -->
    <div class="absolute inset-0 h-[600px] z-0 parallax-bg overflow-hidden">
      <Image 
        src={activityImage} 
        alt="活動背景画像" 
        class="w-full h-full object-cover transform transition-transform ease-out duration-1000 will-change-transform" 
      />
      <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-white/80 to-white"></div>
    </div>
    
    <!-- ヘッダー -->
    <SectionHeading title="活動" />

    <!-- 活動コンテンツ -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-20 mb-12">
      {activities.map((activity) => (
        <article class="work-item">
          <a href={activity.link} class="card card-item">
            <AnimatedImage src={heroImage_1} alt={activity.title} />
            <div class="card-body p-0 pt-2">
              <h2 class="card-title fade-in-text opacity-0 translate-y-8">{activity.title}</h2>
              <p class="fade-in-text opacity-0 translate-y-8">{activity.summary}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div class="flex justify-center">
      <Button text="もっと見てみる！" href="/activities" type="arrow-forward" />
    </div>
  </section>

  <!-- プロフィールセクション -->
  <section id="profile" class={sectionClass.replace('lg:px-16', 'lg:px-[10%]')}>
    <SectionHeading title="プロフィール" />
    <div class="flex flex-col lg:flex-row items-start justify-center my-20">
      
      <!-- プロフィール写真 -->
      <div class="avatar flex justify-center lg:w-1/2 work-item">
        <AnimatedImage src={profile} alt="プロフィール写真" loading="eager" noScale={true} />
      </div>

      <!-- プロフィール情報 -->
      <div class="lg:w-1/2 lg:pl-8 mt-8 lg:mt-0">

        <!-- 名前 -->
        <h3 class="text-3xl sm:text-4xl font-bold mb-8 fade-in-text opacity-0 translate-y-8">
          {AUTHOR}
          <span class="hidden xl:inline">/</span>
          <span class="hidden xl:inline">{AUTHOR_ENGLISH}</span>
          <span class="block xl:hidden text-xl font-normal mt-2">{AUTHOR_ENGLISH}</span>
        </h3>

        <!-- 概要 -->
        <p class="text-justify leading-relaxed fade-in-text opacity-0 translate-y-8">{AUTHOR_SUMMARY}</p>
        
        <!-- 経歴 -->
        <CyberHeading text="経歴" color="blue" />
        <CyberTimeline items={timeline} />
        
        <!-- 資格 -->
        <CyberHeading text="資格" color="green" />
        <CyberList items={certifications.filter(item => item.mark && item.name).map(item => item.name!)} />
        <CyberCollapse title="全て見てみる！" items={certifications} />

        <!-- メディア -->
        <CyberHeading text="メディア" color="red" />
        <CyberMediaList items={media} />

        <!-- スキル -->
        <CyberHeading text="スキル" color="purple" />
        <CyberSkills skillCategories={skillCategories} />
      </div>
    </div>
  </section>

  <!-- 連絡先セクション -->
  <section id="links" class=`${sectionClass} relative`>

    <!-- 背景画像 -->
    <div class="absolute inset-0 h-[600px] z-0 parallax-bg overflow-hidden">
      <Image 
        src={linkImage} 
        alt="連絡先背景画像" 
        class="w-full h-full object-cover transform transition-transform ease-out duration-1000 will-change-transform" 
      />
      <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-white/80 to-white"></div>
    </div>

    <!-- ヘッダー -->
    <SectionHeading title="連絡先" />

    <!-- 連絡先コンテンツ -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 my-20">
      {socialLinks.map((item) => (
        <article class="fade-in-text opacity-0 translate-y-8">
          <a href={item.link} class="group" target={item.name !== 'Email' ? "_blank" : undefined} rel={item.name !== 'Email' ? "noopener noreferrer" : undefined}>
            <div class={'text-primary-content py-4 aspect-video relative overflow-hidden rounded-xl transition-transform duration-500 transform group-hover:scale-105 group-hover:rotate-3 group-hover:shadow-2xl flex flex-col items-center justify-center'} style={`background-color: ${item.color}`}>
              <Icon name={getIconName('prime', item.icon ?? '')} size={128} style={{ transform: item.icon === 'twitter' ? 'scale(0.625)' : 'scale(1)' }} />
              <p class="text-2xl xl:text-3xl font-bold">{item.name}</p>
              <div class="absolute inset-0 bg-gradient-to-t from-black opacity-0 group-hover:opacity-30 transition-opacity duration-500"></div>
            </div>
            <div class="pt-2 text-center">
              <p class="fade-in-text opacity-0 translate-y-8">{item.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

</Layout>
