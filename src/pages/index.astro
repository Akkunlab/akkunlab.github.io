  {
    id: 1,
    title: "ドローンプログラミング教室",
    summary: "小中学生向けのプログラミング教室を企画・運営",
    image: "/assets/works/work1.jpg",
    link: "#",
  },
  {
    id: 2,
    title: "常陸frogs",
    summary: "社会課題を解決するリーダーシッププログラムに参加",
    image: "/assets/works/work2.jpg",
    link: "#",
  },
  {
    id: 3,
    title: "光の祭",
    summary: "プロジェクションマッピングイベントの企画運営",
    image: "/assets/works/work3.jpg",
    link: "#",
  },
  {
    id: 4,
    title: "AWSロボットデリバリーチャレンジ",
    summary: "自律走行ロボットの開発と競技会での優勝",
    image: "/assets/works/work4.jpg",
    link: "#",
  },
  {
    id: 5,
    title: "研究活動",
    summary: "エレクトロニクスと情報技術を融合した研究を推進",
    image: "/assets/works/work5.jpg",
    link: "#",
  },
  {
    id: 6,
    title: "ボランティア活動",
    summary: "地域コミュニティへの技術支援と教育活動",
    image: "/assets/works/work6.jpg",
    link: "#",
  }
];
const timeline = [
  {
    date: '2025/04 -',
    title: '筑波大学大学院',
    description: '人間総合科学学術院/研究群 情報学学位プログラム',
  },{
    date: '2023/04 - 2025/03',
    title: '茨城大学',
    description: '工学部 電気電子システム工学科',
  }, {
    date: '2018/04 - 2023/03',
    title: '福島工業高等専門学校',
    description: '電気電子システム工学科',
  },
];
const qualifications = [
  {
    name: '応用情報技術者試験',
    date: '2022年',
    mark: true,
  }, {
    name: 'ディジタル技術検定 1級情報',
    date: '2022年',
    mark: true,
  }, {
    name: '基本情報技術者試験',
    date: '2021年',
    mark: true,
  }, {
    name: 'ディジタル技術検定 2級情報',
    date: '2020年',
    mark: false,
  }, {
    name: 'ディジタル技術検定 3級',
    date: '2020年',
    mark: false,
  }, {
    name: '第二種電気工事士',
    date: '2020年',
    mark: true,
  }, {
    name: 'IT パスポート試験',
    date: '2019年',
    mark: false,
  },
];
const media = [
  {
    title: '常陸frogs5期生決定！中学生から大学生までの次世代リーダー8名が挑む「社会課題を解決し、未来を創造する」ための半年間',
    source: '常陸frogs',
    date: '2023.7.5',
    url: 'https://www.hitachifrogs.com/post/selection2023',
  }, {
    title: 'ディジタル技術検定試験で優秀賞及び団体優秀賞を受賞しました',
    source: '福島高専',
    date: '2023.2.10',
    url: 'https://www.fukushima-nct.ac.jp/fk_news/post_632.html',
  }, {
    title: '「光の祭」を開催しました',
    source: '福島高専',
    date: '2023.2.3',
    url: 'https://www.fukushima-nct.ac.jp/fk_news/post_625.html',
  }, {
    title: '【高専祭】福島高専の磐陽祭が楽しすぎた件。',
    source: 'みんなの高専チャンネル',
    date: '2023.1.28',
    url: 'https://youtu.be/a5CpZ8VdtK0',
  }, {
    title: '【福島県磐梯町で開催】親子で学べる ドローンプログラミング教室',
    source: 'PR TIMES',
    date: '2022.8.25',
    url: 'https://prtimes.jp/main/html/rd/p/000000001.000106546.html',
  }, {
    title: '自律走行ロボットで競う学生対抗「AWSロボットデリバリーチャレンジ」予選トップ通過チームにインタビュー　速く走るポイントは',
    source: 'ロボスタ',
    date: '2021.4.26',
    url: 'https://robotstart.info/2021/04/26/aws-rdc-int.html',
  },
];
---

<Layout title="岸本篤 / Atsushi Kishimoto Portfolio">
  
  <!-- ヒーローセクション -->
   <section class="relative h-screen">
    <Image src={heroImage} alt="メインビジュアル" class="h-full object-cover" id="hero-image" loading="eager" />
    <div class="absolute inset-0 flex items-end pl-[3%] pb-8">
      <h2 class="text-4xl sm:text-6xl lg:text-8xl font-bold text-primary-content hero-text">
        {HERO_TITLE_LINES.map((line, index) => (
          <span class="block bg-base-300 pt-0 pb-1 sm:pb-3 px-2 sm:px-5 m-3 w-fit invisible" style={`animation-delay: ${0.5 + index * 0.7}s;`} data-index={index}>
            {line}
          </span>
        ))}
      </h2>
    </div>
  </section>

  <!-- 作品セクション -->
  <section id="works" class="mb-20 px-4 md:px-16 pt-24 mt-8">
    <SectionHeading title="作品" />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-20 mb-12">
      {works.map((work) => (
        <article class="work-item">
          <a href={work.link} class="card card-item">
            <AnimatedImage src={heroImage} alt={work.title} />
            <div class="card-body p-0 pt-2">
              <h2 class="card-title">{work.title}</h2>
              <p>{work.summary}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <Button text="もっと見てみる！" />
  </section>

  <!-- 活動セクション -->
  <section id="activities" class="mb-20 px-4 md:px-16 pt-24 mt-8">
    <SectionHeading title="活動" />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-20 mb-12">
      {activities.map((activity) => (
        <article class="work-item">
          <a href={activity.link} class="card card-item">
            <AnimatedImage src={heroImage} alt={activity.title} />
            <div class="card-body p-0 pt-2">
              <h2 class="card-title">{activity.title}</h2>
              <p>{activity.summary}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <Button text="もっと見てみる！" />
  </section>

  <!-- プロフィールセクション -->
  <section id="profile" class="mb-20 px-4 md:px-[10%] pt-24 mt-8">
    <SectionHeading title="プロフィール" />
    <div class="flex flex-col md:flex-row items-start justify-center my-20">
      
      <!-- プロフィール写真 -->
      <div class="avatar flex justify-center md:w-1/2 work-item">
        <AnimatedImage src={profile} alt="プロフィール写真" loading="eager" noScale={true} />
      </div>

      <!-- プロフィール情報 -->
      <div class="md:w-1/2 md:pl-8 mt-8 md:mt-0">

        <!-- 名前 -->
        <h3 class="text-3xl sm:text-4xl font-bold mb-8">
          {AUTHOR}
          <span class="hidden xl:inline">/</span>
          <span class="hidden xl:inline">{AUTHOR_ENGLISH}</span>
          <span class="block xl:hidden text-xl font-normal mt-2">{AUTHOR_ENGLISH}</span>
        </h3>

        <!-- 概要 -->
        <p class="text-justify leading-relaxed">{AUTHOR_SUMMARY}</p>

        <!-- 経歴 -->
        <h3 class="text-2xl font-bold mt-8 mb-4">経歴</h3>
        <ul class="timeline timeline-snap-icon timeline-vertical timeline-compact">
          {timeline.map(item => (
            <li>
              <div class="timeline-middle">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
              </div>
              <div class="timeline-end my-4">
                <time>{item.date}</time>
                <p class="text-lg font-bold">{item.title}</p>
                <p>{item.description}</p>
              </div>
              <hr/>
            </li>
          ))}
        </ul>

        <!-- 資格 -->
        <h3 class="text-2xl font-bold mt-8 mb-4">資格</h3>
        <ul class="list-disc list-outside pl-8 space-y-1">
          {qualifications
            .filter(item => item.mark)
            .map(item => (
              <li>{item.name}</li>
            )
          )}
        </ul>
        <div tabindex="0" class="collapse collapse-arrow">
          <input type="checkbox" aria-label="checkbox" /> 
          <div class="collapse-title text-base px-0">
            全て見てみる！
          </div>
          <div class="collapse-content"> 
            <ul class="list-disc list-outside pl-4 space-y-1">
              {qualifications.map(item => (
                <li>{item.date} {item.name}</li>
              ))}
            </ul>
          </div>
        </div>

        <!-- メディア -->
        <h3 class="text-2xl font-bold mt-4 mb-4">メディア</h3>
        <ul class="list-disc list-outside pl-8 space-y-1">
          {media.map(item => (
            <li class="text-justify my-2">
              <a href={item.url} class="underline hover:text-primary transition" target="_blank" rel="noopener noreferrer">
                {item.title}, {item.source}, {item.date}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- リンクセクション -->
  <section id="links" class="mb-20 px-4 md:px-16 pt-24 mt-8">
    <SectionHeading title="リンク" />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 my-20">
      {SNS_LINKS.map((item) => (
        <article>
          <a href={item.url} class="group" target={item.name !== 'Email' ? "_blank" : undefined} rel={item.name !== 'Email' ? "noopener noreferrer" : undefined}>
            <div class={'text-primary-content py-4 aspect-video relative overflow-hidden rounded-xl transition-transform duration-500 transform group-hover:scale-105 group-hover:rotate-3 group-hover:shadow-2xl flex flex-col items-center justify-center'} style={`background-color: ${item.color}`}>
              <Icon name={getIconName('prime', item.icon)} size={128} style={{ transform: item.icon === 'twitter' ? 'scale(0.625)' : 'scale(1)' }} />
              <p class="text-2xl xl:text-3xl font-bold">{item.name}</p>
              <div class="absolute inset-0 bg-gradient-to-t from-black opacity-0 group-hover:opacity-30 transition-opacity duration-500"></div>
            </div>
            <div class="pt-2 text-center">
              <p>{item.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

</Layout>
