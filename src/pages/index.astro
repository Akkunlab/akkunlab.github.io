---
import { Image } from 'astro:assets';

import Layout from '@/layouts/Layout.astro';
import About from '@/components/Top/About.astro';

import heroImage from '@/assets/images/hero-image.png';

const heroTitleLines = [
  'テクノロジーと',
  'アートの融合で',
  '人々を幸せに'
];
---

<Layout title="岸本篤 / Atsushi Kishimoto Portfolio">

  <!-- ヒーローセクション -->
  <section class="relative h-screen">
    <Image src={heroImage} alt="メインビジュアル" class="h-full object-cover" />
    <div class="absolute inset-0 flex items-end pl-[3%] pb-8">
      <h2 class="text-8xl font-bold text-white">
        {heroTitleLines.map(line => (
          <span class="block bg-black pt-0 pb-3 px-5 m-3">{line}</span>
        ))}
      </h2>
    </div>
  </section>

	<About />

</Layout>
