---
import { Image } from 'astro:assets';

import Layout from '@/layouts/Layout.astro';
import About from '@/components/Top/About.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';

import heroImage from '@/assets/images/hero-image.png';
import profile from '@/assets/images/profile.jpg';

const heroTitleLines = [
  'テクノロジーと',
  'アートの融合で',
  '人々を幸せに'
];

const works = [
  {
    id: 1,
    title: "Awesome Project",
    summary: "テクノロジーとアートの融合を実現したプロジェクト",
    image: "/assets/works/work1.jpg",
    link: "#",
  },
  {
    id: 2,
    title: "Creative Design",
    summary: "独創的なUI/UXを追求したデザインプロジェクト",
    image: "/assets/works/work2.jpg",
    link: "#",
  },
  {
    id: 3,
    title: "Innovative App",
    summary: "新しい技術を活用したモバイルアプリケーション",
    image: "/assets/works/work3.jpg",
    link: "#",
  },
  {
    id: 4,
    title: "Web Development",
    summary: "最新のWeb技術を駆使した開発プロジェクト",
    image: "/assets/works/work4.jpg",
    link: "#",
  },
  {
    id: 5,
    title: "Digital Marketing",
    summary: "デジタルマーケティングを活用したプロモーション",
    image: "/assets/works/work5.jpg",
    link: "#",
  },
  {
    id: 6,
    title: "Social Media",
    summary: "SNSを活用したコミュニケーションプロジェクト",
    image: "/assets/works/work6.jpg",
    link: "#",
  }
];
---

<Layout title="岸本篤 / Atsushi Kishimoto Portfolio">

  <!-- ヒーローセクション -->
  <section class="relative h-screen">
    <Image src={heroImage} alt="メインビジュアル" class="h-full object-cover" />
    <div class="absolute inset-0 flex items-end pl-[3%] pb-8">
      <h2 class="text-8xl font-bold text-white">
        {heroTitleLines.map(line => (
          <span class="block bg-black pt-0 pb-3 px-5 m-3">{line}</span>
        ))}
      </h2>
    </div>
  </section>

  <!-- 作品セクション -->
  <section class="my-20 px-4 md:px-16">
    <SectionHeading title="作品" />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-20 mb-12">
      {works.map((work) => (
        <article>
          <a href={work.link} class="card card-item">
            <figure class="rounded-xl overflow-hidden">
              <Image
                src={heroImage}
                alt={work.title}
                class="transition-transform duration-500 hover:scale-110"
              />
            </figure>
            <div class="card-body p-0 pt-2">
              <h2 class="card-title">{work.title}</h2>
              <p>{work.summary}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <Button text="もっと見る" />
  </section>

  <!-- Aboutセクション -->
  <section class="my-20 px-4 md:px-16">
    <SectionHeading title="プロフィール" />
    <div class="flex flex-col md:flex-row items-center justify-center p-6">

      <div class="avatar flex justify-center">
        <Image src={profile} alt="プロフィール写真" loading="eager" width={350} />
      </div>

      <div class="md:w-1/2 md:pl-8">
        <h2 class="text-3xl font-bold mb-4">岸本篤</h2>
      </div>
    </div>
  </section>

	<About />

</Layout>
