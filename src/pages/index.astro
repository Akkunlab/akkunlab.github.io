---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getIconName } from '@/utils/icon'
import { fetchNotionPageList } from '@/utils/notion';
import type { SkillCategory } from '@/types';

import Layout from '@/layouts/Layout.astro';
import HeroCarousel from '@/components/HeroCarousel.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import AnimatedImage from '@/components/AnimatedImage.astro';
import CyberInfoGraphics from '@/components/CyberInfographics.astro';
import CyberHeading from '@/components/CyberHeading.astro';
import CyberTimeline from '@/components/CyberTimeline.astro';
import CyberList from '@/components/CyberList.astro';
import CyberMediaList from '@/components/CyberMediaList.astro';
import CyberCollapse from '@/components/CyberCollapse.astro';
import CyberSkills from '@/components/CyberSkills.astro';

import heroImage_1 from '@/assets/images/hero-image_1.jpg';
import activityImage from '@/assets/images/activity-image.jpg';
import linkImage from '@/assets/images/link-image.jpg';
import profile from '@/assets/images/profile.jpg';

import {
  AUTHOR,
  AUTHOR_ENGLISH,
  AUTHOR_SUMMARY,
  HERO_TITLE_LINES
} from '@/constants';

const PORTFOLIO_DATABASE_ID = import.meta.env.PORTFOLIO_DATABASE_ID;
const MEDIA_COVERAGE_DATABASE_ID = import.meta.env.MEDIA_COVERAGE_DATABASE_ID;
const CERTIFICATIONS_DATABASE_ID = import.meta.env.CERTIFICATIONS_DATABASE_ID;
const EDUCATION_CAREER_DATABASE_ID = import.meta.env.EDUCATION_CAREER_DATABASE_ID;
const SOCIAL_LINKS_DATABASE_ID = import.meta.env.SOCIAL_LINKS_DATABASE_ID;

const skillCategories: SkillCategory[] = [
  {
    category: 'プログラミング言語',
    color: 'from-blue-500 to-cyan-500',
    skills: [
      { name: 'Python', icon: 'python' },
      { name: 'TypeScript', icon: 'typescript' },
      { name: 'C++', icon: 'cplusplus' },
      { name: 'C#', icon: 'csharp' },
      { name: 'C', icon: 'c' },
      { name: 'Kotlin', icon: 'kotlin' },
    ]
  },
  {
    category: 'フロントエンド',
    color: 'from-green-500 to-emerald-500',
    skills: [
      { name: 'React', icon: 'react' },
      { name: 'Vue.js', icon: 'vuejs' },
      { name: 'Next.js', icon: 'nextjs' },
      { name: 'Nuxt.js', icon: 'nuxtjs' },
      { name: 'Astro', icon: 'astro' },
      { name: 'HTML', icon: 'html5' },
      { name: 'CSS', icon: 'css3' },
      { name: 'Tailwind CSS', icon: 'tailwindcss' },
      { name: 'Sass', icon: 'sass' },
      { name: 'Bootstrap', icon: 'bootstrap' },
      { name: 'Chakra UI', icon: 'chakraui' },
      { name: 'Vuetify', icon: 'vuetify' },
    ]
  },
  {
    category: 'バックエンド・インフラ',
    color: 'from-purple-500 to-violet-500',
    skills: [
      { name: 'Node.js', icon: 'nodejs' },
      { name: 'Express', icon: 'express' },
      { name: 'MySQL', icon: 'mysql' },
      { name: 'Firebase', icon: 'firebase' },
      { name: 'Docker', icon: 'docker' },
      { name: 'Heroku', icon: 'heroku' },
      { name: 'Vercel', icon: 'vercel' },
    ]
  },
  {
    category: 'モバイル・ゲーム開発',
    color: 'from-orange-500 to-red-500',
    skills: [
      { name: 'Android', icon: 'android' },
      { name: 'Flutter', icon: 'flutter' },
      { name: 'Unity', icon: 'unity' },
      { name: 'Android Studio', icon: 'androidstudio' },
    ]
  },
  {
    category: 'ツール・その他',
    color: 'from-pink-500 to-rose-500',
    skills: [
      { name: 'Git', icon: 'git' },
      { name: 'GitHub', icon: 'github' },
      { name: 'Visual Studio Code', icon: 'vscode' },
      { name: 'Figma', icon: 'figma' },
      { name: 'Blender', icon: 'blender' },
      { name: 'Arduino', icon: 'arduino' },
      { name: 'Raspberry Pi', icon: 'raspberrypi' },
      { name: 'ROS', icon: 'ros' },
      { name: 'OpenCV', icon: 'opencv' },
    ]
  },
];

const works = await fetchNotionPageList(PORTFOLIO_DATABASE_ID, { 
  types: '作品',
  sorts: [{ property: 'event', direction: 'descending' }]
});
const activities = await fetchNotionPageList(PORTFOLIO_DATABASE_ID, { 
  types: '活動',
  sorts: [{ property: 'event', direction: 'descending' }]
});
const careers = await fetchNotionPageList(EDUCATION_CAREER_DATABASE_ID, {
  types: 'career',
  sorts: [{ property: 'start', direction: 'descending' }]
});
const educations = await fetchNotionPageList(EDUCATION_CAREER_DATABASE_ID, {
  types: 'education',
  sorts: [{ property: 'start', direction: 'descending' }]
});
const certifications = await fetchNotionPageList(CERTIFICATIONS_DATABASE_ID, {
  sorts: [{ property: 'date', direction: 'descending' }]
});
const mediaCoverage = await fetchNotionPageList(MEDIA_COVERAGE_DATABASE_ID, {
  sorts: [{ property: 'date', direction: 'descending' }]
});
const socialLinks = await fetchNotionPageList(SOCIAL_LINKS_DATABASE_ID);

const sectionClass = 'py-40 px-4 md:px-16';
---

<Layout showSplash={true}>
  
  <!-- ヒーローセクション -->
  <section class="relative h-screen">
    <HeroCarousel />
    <div class="absolute inset-0 flex items-end pl-[3%] pb-[200px] md:pb-8">
      <h2 class="text-4xl sm:text-6xl lg:text-8xl font-bold text-primary-content hero-text">
        {HERO_TITLE_LINES.map((line, index) => (
          <span class="block bg-base-300 pt-0 pb-1 sm:pb-3 px-2 sm:px-5 m-3 w-fit invisible" style={`animation-delay: ${0.5 + index * 0.7}s;`} data-index={index}>
            {line}
          </span>
        ))}
      </h2>
    </div>
  </section>

  <!-- インフォグラフィックスセクション -->
  <section id="infographics" class={sectionClass.replace('md:px-16', 'max-w-[1300px] mx-auto')}>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-12">
      <CyberInfoGraphics title="制作した作品数" icon="work" count={works.length} color="cyan" href="#works" />
      <CyberInfoGraphics title="参加したイベント数" icon="event-available-rounded" count={activities.length} color="purple" href="#activities" />
      <CyberInfoGraphics title="習得したスキル数" icon="workspace-premium" count={30} color="orange" href="#skills" />
    </div>
  </section>

  <!-- 作品セクション -->
  <section id="works" class=`${sectionClass} relative`>

    <!-- 背景画像 -->
    <div class="absolute inset-0 h-[600px] z-0 parallax-bg overflow-hidden">
      <Image 
        src={heroImage_1} 
        alt="作品背景画像" 
        class="w-full h-full object-cover transform transition-transform ease-out duration-1000 will-change-transform" 
      />
      <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-white/80 to-white"></div>
    </div>
  
    <!-- ヘッダー -->
    <SectionHeading title="作品" />

    <!-- 作品コンテンツ -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-20 mb-12">
      {works.map((work) => (
        <article class="work-item">
          <a href={`/works/${work.slug}`} class="card card-item">
            <AnimatedImage src={work.image ?? ''} alt={work.title ?? ''} class="aspect-video" />
            <div class="card-body p-0 pt-2">
              <h2 class="card-title fade-in-text opacity-0 translate-y-8">{work.title}</h2>
              <p class="fade-in-text opacity-0 translate-y-8">{work.summary}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div class="flex justify-center">
      <Button text="もっと見てみる！" href="/works" type="arrow-forward" />
    </div>
  </section>

  <!-- 活動セクション -->
  <section id="activities" class=`${sectionClass} relative`>
    
    <!-- 背景画像 -->
    <div class="absolute inset-0 h-[600px] z-0 parallax-bg overflow-hidden">
      <Image 
        src={activityImage} 
        alt="活動背景画像" 
        class="w-full h-full object-cover transform transition-transform ease-out duration-1000 will-change-transform" 
      />
      <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-white/80 to-white"></div>
    </div>
    
    <!-- ヘッダー -->
    <SectionHeading title="活動" />

    <!-- 活動コンテンツ -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-20 mb-12">
      {activities.map((activity) => (
        <article class="work-item">
          <a href={`/activities/${activity.slug}`} class="card card-item">
            <AnimatedImage src={activity.image ?? ''} alt={activity.title ?? ''} class="aspect-video" />
            <div class="card-body p-0 pt-2">
              <h2 class="card-title fade-in-text opacity-0 translate-y-8">{activity.title}</h2>
              <p class="fade-in-text opacity-0 translate-y-8">{activity.summary}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div class="flex justify-center">
      <Button text="もっと見てみる！" href="/activities" type="arrow-forward" />
    </div>
  </section>

  <!-- プロフィールセクション -->
  <section id="profile" class={sectionClass.replace('md:px-16', 'max-w-[1300px] mx-auto')}>
    <SectionHeading title="プロフィール" />
    <div class="flex flex-col lg:flex-row mt-20">
      
      <!-- プロフィール写真 -->
      <div class="avatar flex justify-center lg:w-1/3 work-item">
        <AnimatedImage src={profile} alt="プロフィール写真" loading="eager" noScale={true} />
      </div>

      <!-- プロフィール情報 -->
      <div class="lg:w-2/3 lg:pl-12 mt-8 lg:mt-0">

        <!-- 名前 -->
        <h3 class="text-3xl sm:text-4xl font-bold mb-8 fade-in-text opacity-0 translate-y-8">
          {AUTHOR}
          <span class="hidden xl:inline">/</span>
          <span class="hidden xl:inline">{AUTHOR_ENGLISH}</span>
          <span class="block xl:hidden text-xl font-normal mt-2">{AUTHOR_ENGLISH}</span>
        </h3>

        <!-- 概要 -->
        <p class="text-justify leading-relaxed fade-in-text opacity-0 translate-y-8">{AUTHOR_SUMMARY}</p>
      </div>
    </div>

    <div class="flex flex-col">

      <!-- 学歴・職歴 -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <CyberHeading text="職歴" color="blue" />
          <CyberTimeline items={careers} />
        </div>
        <div>
          <CyberHeading text="学歴" color="blue" />
          <CyberTimeline items={educations} />
        </div>
      </div>

      <!-- 資格 -->
      <CyberHeading text="資格" color="green" />
      <CyberList items={certifications.filter(item => item.mark && item.name).map(item => item.name!)} />
      <CyberCollapse title="全て見てみる！" items={certifications} />

      <!-- メディア -->
      <CyberHeading text="メディア" color="red" />
      <CyberMediaList items={mediaCoverage} />

      <!-- スキル -->
      <div id="skills">
        <CyberHeading text="スキル" color="purple"/>
        <CyberSkills skillCategories={skillCategories} />
      </div>
    </div>
  </section>

  <!-- 連絡先セクション -->
  <section id="links" class=`${sectionClass} relative`>

    <!-- 背景画像 -->
    <div class="absolute inset-0 h-[600px] z-0 parallax-bg overflow-hidden">
      <Image 
        src={linkImage} 
        alt="連絡先背景画像" 
        class="w-full h-full object-cover transform transition-transform ease-out duration-1000 will-change-transform" 
      />
      <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-white/80 to-white"></div>
    </div>

    <!-- ヘッダー -->
    <SectionHeading title="連絡先" />

    <!-- 連絡先コンテンツ -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 my-20">
      {socialLinks.map((item) => (
        <article class="fade-in-text opacity-0 translate-y-8">
          <a href={item.link} class="group" target={item.name !== 'Email' ? "_blank" : undefined} rel={item.name !== 'Email' ? "noopener noreferrer" : undefined}>
            <div class={'text-primary-content py-4 aspect-video relative overflow-hidden rounded-xl transition-transform duration-500 transform group-hover:scale-105 group-hover:rotate-3 group-hover:shadow-2xl flex flex-col items-center justify-center'} style={`background-color: ${item.color}`}>
              <Icon name={getIconName('prime', item.icon ?? '')} size={128} style={{ transform: item.icon === 'twitter' ? 'scale(0.625)' : 'scale(1)' }} />
              <p class="text-2xl xl:text-3xl font-bold">{item.name}</p>
              <div class="absolute inset-0 bg-gradient-to-t from-black opacity-0 group-hover:opacity-30 transition-opacity duration-500"></div>
            </div>
            <div class="pt-2 text-center">
              <p class="fade-in-text opacity-0 translate-y-8">{item.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

</Layout>
