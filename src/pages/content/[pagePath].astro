---
import { fetchNotionPage, fetchNotionPageList } from '@/utils/notion';
import { markdownToHtml } from '@/utils/markdown';

type StaticPath = { params: { pagePath: string } };

export const getStaticPaths = async (): Promise<StaticPath[]> => {
  const pageList = await fetchNotionPageList();

  return pageList.map((page) => ({
    params: { pagePath: page.path },
  }));
};

const { pagePath } = Astro.params;
const markdownContent = pagePath ? await fetchNotionPage(pagePath) : null;

const htmlContent = markdownContent ? await markdownToHtml(markdownContent) : null;
---



<html>
  <head>
    <meta charset="UTF-8">
    <style>
/* 特異性を高める例 */
body h1 {
  font-size: 2em;
  font-weight: bold;
}

      h2 {
        font-size: 1.75em;
        font-weight: bold;
      }
      
      h3 {
        font-size: 1.5em;
        font-weight: bold;
      }
      
      p {
        font-size: 1em;
        margin: 0.5em 0;
      }
      
      ul, ol {
        margin: 1em 0;
        padding-left: 2em;
      }
      
      li {
        margin: 0.5em 0;
      }
      
      blockquote {
        border-left: 4px solid #ccc;
        padding-left: 1em;
        margin: 1em 0;
        color: #666;
      }
      
      pre {
        background-color: #f5f5f5;
        padding: 1em;
        overflow: auto;
      }
      </style>
  </head>
  <body>
    {htmlContent ? (
      <Fragment set:html={htmlContent} />
    ) : (
      <p>ページが見つかりませんでした</p>
    )}
  </body>
</html>
