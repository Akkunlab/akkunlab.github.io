---
import Layout from '@/layouts/Layout.astro';
import { fetchNotionPageIds } from '@/utils/notion';
import type { Card } from '@/types';
import { TAGS } from '@/constants';

// const pages = await fetchNotionPageIds();

const cards: Card[] = [
  {
    id: 'test',
    types: '作品',
    title: 'タイトル',
    summary: '説明',
    tags: [
      { id: 'design', name: 'Design' },
      { id: 'development', name: 'Development' },
    ],
    year: '2021',
    link: '#',
    publication: '20240101',
    image: '/ogp.png',
  }
];
---

<Layout title="Welcome to Astro.">
  <main>
    <div class="p-6">

      <!-- タイトル -->
      <section class="mb-6">
        <h1 class="text-4xl font-bold">Works</h1>
      </section>

      <!-- タグ -->
      <section class="my-6">
        {TAGS.map((tag) => (
          <button
            class="btn btn-outline rounded-full btn-sm m-1 filter-btn hover:bg-button-active hover:text-button-active-content"
            data-tag={tag.id}
          >
            {tag.name}
          </button>
        ))}
      </section>

      <!-- カード一覧 -->
      <section class="my-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-6">
          {cards.map((card) => (
            <a href={card.link} class="card card-item" data-tags={card.tags.map(tag => tag.id).join(',')}>
              <figure>
                <img src={card.image} alt={card.title} class="rounded-xl" />
              </figure>
              <div class="card-body p-0 pt-2">
                <h2 class="card-title">{card.title}</h2>
                <p>{card.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('button.filter-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.card-item');
  const urlParams = new URLSearchParams(window.location.search);
  const initialTag = urlParams.get('tag') || 'all';

  /* カードのフィルタリング */
  const filterCards = (tag: string): void => {
    cards.forEach(card => {
      const tags = (card.dataset.tags || '').split(',');
      card.style.display = (tag === 'all' || tags.includes(tag)) ? 'block' : 'none';
    });
  };

  /* URLのクエリパラメータを更新 */
  const updateURLParameter = (tag: string): void => {
    const url = new URL(window.location.href);
    url.searchParams.set('tag', tag);
    window.history.pushState({ path: url.href }, '', url.href);
  };

  /* ボタンのアクティブ状態を更新 */
  const setActiveButton = (tag: string): void => {
    buttons.forEach(button => {
      const isActive = button.getAttribute('data-tag') === tag;
      button.classList.toggle('bg-button-active', isActive);
      button.classList.toggle('text-button-active-content', isActive);
      button.classList.toggle('btn-outline', !isActive);
    });
  };

  /* フィルター用ボタンのクリックイベント */
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const tag = button.getAttribute('data-tag');

      if (tag) {
        filterCards(tag);
        updateURLParameter(tag);
        setActiveButton(tag);
      }
    });
  });

  /* 初期設定 */
  filterCards(initialTag);
  setActiveButton(initialTag);
</script>
