---
import { fetchNotionPage, fetchNotionPageList } from '@/utils/notion';
import { markdownToHtml } from '@/utils/markdown';
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Button from '@/components/Button.astro';
import { MARKDOWN_STYLES } from '@/constants';

type StaticPath = {
  params: {
    pagePath: string
  },
  props: {
    id: string,
    title: string
  }
};

export const getStaticPaths = async (): Promise<StaticPath[]> => {
  const pageList = await fetchNotionPageList('作品');

  return pageList.map((page) => ({
    params: { pagePath: page.slug },
    props: { 
      id: page.id,
      title: page.title
    }
  }));
};

const { id: pageId, title } = Astro.props;
const markdownContent = pageId ? await fetchNotionPage(pageId) : null;
const htmlContent = markdownContent ? await markdownToHtml(markdownContent) : null;

const breadcrumbItems = [
  { label: 'ホーム', href: '/', isHome: true },
  { label: '作品', href: '/works' },
  { label: title }
];
---

<Layout title={title}>
  <div class="pt-36 pb-40 px-0 md:px-16 min-h-screen bg-content-bg">

    <!-- ヘッダーセクション -->
    <div class="max-w-4xl mx-auto px-4 md:px-0">

      <!-- パンくずリスト -->
      <Breadcrumb items={breadcrumbItems} />
      
      <!-- タイトル -->
      <div>
        <h1 class="text-xl sm:text-3xl md:text-5xl mb-8 font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">
          {title}
        </h1>
        <div class="w-full h-1 bg-gradient-to-r from-primary to-secondary"></div>
      </div>
    </div>

    <!-- コンテンツセクション -->
    <div class="max-w-4xl mx-auto my-16">
      {htmlContent && (
        <div class="p-4 md:p-8 backdrop-blur-sm bg-white border border-button-border rounded-0 md:rounded-lg shadow-lg">
          <div class={`prose prose-slate max-w-none ${MARKDOWN_STYLES}`} set:html={htmlContent} />
        </div>
      )}
    </div>

    <!-- ボタン -->
    <div class="mt-12 flex justify-center">
      <Button text="作品一覧に戻る！" href="/works" type="arrow-back" />
    </div>
  </div>
</Layout>
