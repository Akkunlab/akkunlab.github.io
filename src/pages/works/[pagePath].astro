---
import { fetchNotionPage, fetchNotionPageList } from '@/utils/notion';
import { markdownToHtml } from '@/utils/markdown';
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Button from '@/components/Button.astro';

type StaticPath = {
  params: {
    pagePath: string
  },
  props: {
    id: string,
    title: string
  }
};

export const getStaticPaths = async (): Promise<StaticPath[]> => {
  const pageList = await fetchNotionPageList();

  return pageList.map((page) => ({
    params: { pagePath: page.slug },
    props: { 
      id: page.id,
      title: page.title
    }
  }));
};

const { id: pageId, title } = Astro.props;
const markdownContent = pageId ? await fetchNotionPage(pageId) : null;
const htmlContent = markdownContent ? await markdownToHtml(markdownContent) : null;

const breadcrumbItems = [
  { label: 'ホーム', href: '/', isHome: true },
  { label: '作品', href: '/works' },
  { label: title }
];

const contentStyles = `
  prose prose-slate max-w-none 
  [&_h1]:text-3xl [&_h1]:font-bold [&_h1]:text-blue-600 [&_h1]:mb-6 [&_h1]:relative [&_h1]:before:content-['>_'] [&_h1]:before:text-blue-500 [&_h1]:before:font-mono
  [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-purple-600 [&_h2]:mb-4 [&_h2]:mt-8 [&_h2]:relative [&_h2]:before:content-['>>_'] [&_h2]:before:text-purple-500 [&_h2]:before:font-mono
  [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-emerald-600 [&_h3]:mb-4 [&_h3]:mt-6 [&_h3]:relative [&_h3]:before:content-['>>>_'] [&_h3]:before:text-emerald-500 [&_h3]:before:font-mono
  [&_p]:text-gray-700 [&_p]:leading-relaxed [&_p]:mb-4
  [&_ul]:ml-6 [&_ul]:mb-4 [&_ul]:text-gray-700 [&_ol]:ml-6 [&_ol]:mb-4 [&_ol]:text-gray-700
  [&_li]:mb-2 [&_li]:relative [&_li::marker]:text-blue-500
  [&_blockquote]:border-l-4 [&_blockquote]:border-blue-500 [&_blockquote]:pl-4 [&_blockquote]:my-6 [&_blockquote]:text-blue-700 [&_blockquote]:bg-blue-50 [&_blockquote]:py-3 [&_blockquote]:rounded-r
  [&_pre]:bg-gray-100 [&_pre]:border [&_pre]:border-gray-300 [&_pre]:rounded-lg [&_pre]:p-4 [&_pre]:overflow-auto [&_pre]:my-6 [&_pre]:text-emerald-700 [&_pre]:font-mono
  [&_code]:bg-gray-200 [&_code]:text-blue-700 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-sm [&_code]:font-mono
  [&_pre_code]:bg-transparent [&_pre_code]:text-emerald-700 [&_pre_code]:p-0
  [&_a]:text-blue-600 [&_a]:hover:text-blue-800 [&_a]:underline [&_a]:transition-colors
  [&_strong]:text-blue-700 [&_strong]:font-bold
  [&_em]:text-purple-600 [&_em]:italic
`.trim();
---

<Layout title={title}>
  <div class="pt-36 pb-40 px-4 md:px-16 min-h-screen bg-content-bg">

    <!-- ヘッダーセクション -->
    <div class="max-w-4xl mx-auto">
      
      <!-- パンくずリスト -->
      <Breadcrumb items={breadcrumbItems} />

      <!-- タイトル -->
      <div>
        <h1 class="text-3xl sm:text-5xl mb-8 font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-purple-600 to-emerald-600">
          {title}
        </h1>
        <div class="w-full h-1 bg-gradient-to-r from-blue-500 to-purple-500"></div>
      </div>
    </div>

    <!-- コンテンツセクション -->
    <div class="max-w-4xl mx-auto my-16">
      {htmlContent && (
        <div class="p-8 backdrop-blur-sm bg-white border border-button-border rounded-lg shadow-lg">
          <div class={contentStyles} set:html={htmlContent} />
        </div>
      )}
    </div>

    <!-- ボタン -->
    <div class="mt-12 flex justify-center">
      <Button text="作品一覧に戻る！" href="/works" type="arrow-back" />
    </div>
  </div>
</Layout>
