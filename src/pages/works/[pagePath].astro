---
import PortfolioDetailPage from '@/components/pages/PortfolioDetailPage.astro';
import { buildDetailStaticPaths } from '@/utils/notion';
import type { NotionRecord } from '@/types';

export const getStaticPaths = () => buildDetailStaticPaths('works');

interface Props {
  page: NotionRecord;
}

const { page } = Astro.props;
---

<PortfolioDetailPage locale="ja" kind="works" page={page} />
