---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
import notFoundImage from '@/assets/images/404.png';

import { IMAGE_FORMAT, IMAGE_QUALITY } from '@/constants';
---

<Layout title="404">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-blue-900 to-purple-900 relative overflow-hidden">
    <div class="text-center">
      
      <!-- タイトル -->
      <div class="mb-8 opacity-0 translate-y-8 animate-fadeInUp">
        <h1 class="text-5xl mb-8 font-bold text-dark-text">
          404
        </h1>
        <div class="h-1 w-full mx-auto bg-gradient-to-r from-primary to-secondary rounded-full shadow-lg shadow-cyan-500/50"></div>
      </div>

      <!-- メインコンテンツ -->
      <div class="mb-16 flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12">

        <!-- 説明文 -->
        <div class="text-center md:text-left opacity-0 translate-y-8 animate-fadeInUp">
          <h2 class="text-xl md:text-3xl mb-6 font-bold text-dark-text">
            リンクが家出しました
          </h2>
          <p class="text-base md:text-xl text-dark-text leading-relaxed">
            置き手紙すら残さず旅に出たようです...<br>
            行き先のヒントはホームに貼ってあります。
          </p>
        </div>

        <!-- 画像 -->
        <div class="flex-shrink-0 opacity-0 translate-y-8 animate-fadeInUp">
          <Image 
            src={notFoundImage} 
            alt="家出したキャラクター" 
            class="w-48 h-48 md:w-64 md:h-64 object-contain"
            loading="eager"
            widths={[192, 256]}
            sizes="256px"
            format={IMAGE_FORMAT}
            quality={IMAGE_QUALITY}
            fetchpriority="high"
          />
        </div>
      </div>

    <div class="flex justify-center">
      <Button text="ホームに戻る" href="/" type="arrow-back" />
    </div>
  </div>
</Layout>
